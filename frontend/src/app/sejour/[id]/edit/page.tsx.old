'use client';

import { useState, useEffect } from 'react';
import { useParams, useRouter } from 'next/navigation';
import Link from 'next/link';

interface Room {
  id: string;
  roomNumber: string;
  hotelId: string;
  accommodationType?: string;
  roomType: string;
  guestInfo: string;
  price: number;
  currency: string;
  costPrice?: number;
  costCurrency?: string;
}

interface FlightInfo {
  id: string;
  flightDate: string;
  airline: string;
  route: string;
  flightNo: string;
  departureTime: string;
  arrivalTime: string;
  price: number;
  currency: string;
  type: 'departure' | 'return';
  costPrice?: number;
  costCurrency?: string;
}

interface TransferInfo {
  id: string;
  date: string;
  provider: string;
  type: 'private' | 'economic';
  vehicle: string;
  time: string;
  price: number;
  currency: string;
  direction: 'arrival' | 'return';
  costPrice?: number;
  costCurrency?: string;
}

interface ExtraService {
  id: string;
  serviceType: string;
  provider: string;
  description: string;
  price: number;
  currency: string;
  costPrice?: number;
  costCurrency?: string;
}

interface SejourData {
  id: string;
  voucherNumber: string;
  customerType: string;
  customerName: string;
  agencyName: string;
  checkInDate: string;
  checkOutDate: string;
  rooms: Room[];
  flights: FlightInfo[];
  transfers: TransferInfo[];
  extraServices: ExtraService[];
  totals: any;
  currency: string;
  status: string;
  notes: string;
  collections: any[];
  salesInvoices: any[];
  purchaseInvoices: any[];
  created_at: string;
}

export default function SejourEditPage() {
  const params = useParams();
  const router = useRouter();
  const [activeTab, setActiveTab] = useState('sales');
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState('');
  const [success, setSuccess] = useState('');

  // Form Data
  const [salesData, setSalesData] = useState({
    voucherNumber: '',
    customerType: 'agency',
    agencyId: '',
    customerName: '',
    checkInDate: '',
    checkOutDate: '',
    status: 'BEKLEMEDE',
    notes: ''
  });

  // Dynamic Data
  const [rooms, setRooms] = useState<Room[]>([]);
  const [flights, setFlights] = useState<FlightInfo[]>([]);
  const [transfers, setTransfers] = useState<TransferInfo[]>([]);
  const [extraServices, setExtraServices] = useState<ExtraService[]>([]);

  // Reference Data
  const [agencies, setAgencies] = useState<any[]>([]);
  const [hotels, setHotels] = useState<any[]>([]);
  const [suppliers, setSuppliers] = useState<any[]>([]);
  const [supplierServiceTypes, setSupplierServiceTypes] = useState<any[]>([]);
  const [categories, setCategories] = useState<any[]>([]);

  const vehicleTypes = ['Vito', 'Ekonomik', 'Binek', 'S Class', 'Sprinter', 'Otobüs'];
  const roomTypes = ['Standart Oda', 'Deluxe Oda', 'Suite', 'Junior Suite', 'King Suite', 'Presidential Suite', 'Aile Odası', 'Tek Kişilik Oda', 'Çift Kişilik Oda'];
  
  // Yardımcı fonksiyonlar
  const getHotelName = (hotelId: string) => {
    const hotel = hotels.find(h => h.id === hotelId);
    return hotel ? hotel.name : 'Bilinmeyen Otel';
  };

  // Section visibility states
  const [showAccommodation, setShowAccommodation] = useState(false);
  const [showFlight, setShowFlight] = useState(false);
  const [showTransfer, setShowTransfer] = useState(false);
  const [showExtraServices, setShowExtraServices] = useState(false);

  const tabs = [
    { id: 'sales', name: 'SATIŞ', icon: '💰' },
    { id: 'purchase', name: 'ALIŞ', icon: '🛒' },
    { id: 'collections', name: 'TAHSİLAT', icon: '💳' }
  ];

  useEffect(() => {
    if (params.id) {
      loadReferenceData();
      loadSejourData();
    }
  }, [params.id]);

  const loadReferenceData = () => {
    try {
      // Load agencies
      const savedAgencies = localStorage.getItem('agencies');
      if (savedAgencies) {
        setAgencies(JSON.parse(savedAgencies));
      }

      // Load hotels
      const savedHotels = localStorage.getItem('hotels');
      if (savedHotels) {
        setHotels(JSON.parse(savedHotels));
      }

      // Load suppliers
      const savedSuppliers = localStorage.getItem('suppliers');
      if (savedSuppliers) {
        setSuppliers(JSON.parse(savedSuppliers));
      }

      // Load supplier service types
      const savedSupplierServiceTypes = localStorage.getItem('supplierServiceTypes');
      if (savedSupplierServiceTypes) {
        setSupplierServiceTypes(JSON.parse(savedSupplierServiceTypes));
      }

      // Load categories
      const savedCategories = localStorage.getItem('categories');
      if (savedCategories) {
        setCategories(JSON.parse(savedCategories));
      }
    } catch (error) {
      console.error('Error loading reference data:', error);
    }
  };

  const loadSejourData = () => {
    try {
      const sejourId = params.id;
      if (!sejourId) {
        setError('Sejour ID bulunamadı');
        return;
      }
      
      console.log('Loading sejour with ID:', sejourId);
      const sejourData = localStorage.getItem('sejourData');
      if (sejourData) {
        const dataArray = JSON.parse(sejourData);
        console.log('Available sejours:', dataArray);
        
        // ID'yi string olarak karşılaştır - hem tam eşleşme hem de string eşleşmesi
        const foundSejour = dataArray.find((s: any) => {
          const sejourIdStr = sejourId.toString();
          const sIdStr = s.id.toString();
          return sIdStr === sejourIdStr || s.id === sejourId;
        });
      
      if (foundSejour) {
          console.log('Found sejour:', foundSejour);
        
          // Set form data - backward compatibility için farklı alan adlarını kontrol et
        setSalesData({
            voucherNumber: foundSejour.voucherNumber || foundSejour.reference || '',
          customerType: foundSejour.customerType || 'agency',
            agencyId: foundSejour.agencyId || '',
            customerName: foundSejour.customerName || '',
          checkInDate: foundSejour.checkInDate || foundSejour.check_in_date || '',
          checkOutDate: foundSejour.checkOutDate || foundSejour.check_out_date || '',
          status: foundSejour.status || 'BEKLEMEDE',
          notes: foundSejour.notes || ''
        });
        
          // Set dynamic data - backward compatibility için farklı alan adlarını kontrol et
        setRooms(foundSejour.rooms || []);
        setFlights(foundSejour.flights || []);
        setTransfers(foundSejour.transfers || []);
          setExtraServices(foundSejour.extraServices || []);
        
          // Eğer veriler varsa ilgili bölümleri otomatik olarak aç
        if (foundSejour.rooms && foundSejour.rooms.length > 0) {
          setShowAccommodation(true);
            console.log('Accommodation section opened automatically');
        }
        if (foundSejour.flights && foundSejour.flights.length > 0) {
          setShowFlight(true);
            console.log('Flight section opened automatically');
        }
        if (foundSejour.transfers && foundSejour.transfers.length > 0) {
          setShowTransfer(true);
            console.log('Transfer section opened automatically');
        }
        if (foundSejour.extraServices && foundSejour.extraServices.length > 0) {
          setShowExtraServices(true);
            console.log('Extra Services section opened automatically');
          }
          
          console.log('Form data set:', {
            voucherNumber: foundSejour.voucherNumber || foundSejour.reference,
            customerType: foundSejour.customerType,
            customerName: foundSejour.customerName,
            checkInDate: foundSejour.checkInDate || foundSejour.check_in_date,
            checkOutDate: foundSejour.checkOutDate || foundSejour.check_out_date,
            status: foundSejour.status,
            notes: foundSejour.notes
          });
          
          console.log('Dynamic data set:', {
            rooms: foundSejour.rooms?.length || 0,
            flights: foundSejour.flights?.length || 0,
            transfers: foundSejour.transfers?.length || 0,
            extraServices: foundSejour.extraServices?.length || 0
          });
          
          // Detay verilerini daha detaylı log'la
          console.log('Rooms data:', foundSejour.rooms);
          console.log('Flights data:', foundSejour.flights);
          console.log('Transfers data:', foundSejour.transfers);
          console.log('ExtraServices data:', foundSejour.extraServices);
          
          // Sejour verisinin tam yapısını log'la
          console.log('Full sejour structure:', JSON.stringify(foundSejour, null, 2));
          
          console.log('Sejour data loaded successfully');
      } else {
          console.error('Sejour not found with ID:', sejourId);
          console.error('Available IDs:', dataArray.map((s: any) => ({ id: s.id, type: typeof s.id, voucherNumber: s.voucherNumber || s.reference })));
        setError('Sejour bulunamadı');
        }
      } else {
        console.error('No sejour data in localStorage');
        setError('Sejour verisi bulunamadı');
      }
    } catch (error) {
      console.error('Error loading sejour:', error);
      setError('Sejour yüklenirken hata oluştu');
    } finally {
      setLoading(false);
    }
  };

  const handleInputChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>) => {
    const { name, value } = e.target;
    setSalesData(prev => ({
      ...prev,
      [name]: value
    }));
  };

  const handleNumberChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const { name, value } = e.target;
    setSalesData(prev => ({
      ...prev,
      [name]: value === '' ? '' : parseFloat(value)
    }));
  };

  // Room Management
  const addRoom = () => {
    const newRoom: Room = {
      id: Date.now().toString(),
      roomNumber: `Oda ${rooms.length + 1}`,
      hotelId: '',
      roomType: 'Standart Oda',
      guestInfo: '',
      price: 0,
      currency: 'TRY'
    };
    setRooms([...rooms, newRoom]);
  };

  const updateRoom = (id: string, field: keyof Room, value: string | number) => {
    setRooms(rooms.map(room => 
      room.id === id ? { ...room, [field]: value } : room
    ));
  };

  const removeRoom = (id: string) => {
    setRooms(rooms.filter(room => room.id !== id));
  };

  // Flight Management
  const addFlight = (type: 'departure' | 'return') => {
    const newFlight: FlightInfo = {
      id: Date.now().toString(),
      flightDate: '',
      airline: '',
      route: '',
      flightNo: '',
      departureTime: '',
      arrivalTime: '',
      price: 0,
      currency: 'EUR',
      type
    };
    setFlights([...flights, newFlight]);
  };

  const updateFlight = (id: string, field: keyof FlightInfo, value: string | number) => {
    setFlights(flights.map(flight => 
      flight.id === id ? { ...flight, [field]: value } : flight
    ));
  };

  const removeFlight = (id: string) => {
    setFlights(flights.filter(flight => flight.id !== id));
  };

  // Transfer Management
  const addTransfer = (direction: 'arrival' | 'return') => {
    const newTransfer: TransferInfo = {
      id: Date.now().toString(),
      date: '',
      provider: '',
      type: 'private',
      vehicle: 'Vito',
      time: '',
      price: 0,
      currency: 'EUR',
      direction
    };
    setTransfers([...transfers, newTransfer]);
  };

  const updateTransfer = (id: string, field: keyof TransferInfo, value: string | number) => {
    setTransfers(transfers.map(transfer => 
      transfer.id === id ? { ...transfer, [field]: value } : transfer
    ));
  };

  const removeTransfer = (id: string) => {
    setTransfers(transfers.filter(transfer => transfer.id !== id));
  };

  // Extra Service Management
  const addExtraService = () => {
    const newService: ExtraService = {
      id: Date.now().toString(),
      serviceType: '',
      provider: '',
      description: '',
      price: 0,
      currency: 'EUR'
    };
    setExtraServices([...extraServices, newService]);
  };

  const updateExtraService = (id: string, field: keyof ExtraService, value: string | number) => {
    setExtraServices(extraServices.map(service => 
      service.id === id ? { ...service, [field]: value } : service
    ));
  };

  const removeExtraService = (id: string) => {
    setExtraServices(extraServices.filter(service => service.id !== id));
  };

  const handleSave = async () => {
    setSaving(true);
    setError('');
    setSuccess('');

    try {
      // Validation
      if (!salesData.voucherNumber.trim()) {
        setError('Voucher numarası gereklidir');
        return;
      }

      if (!salesData.agencyId) {
        setError('Acente seçimi gereklidir');
        return;
      }

      if (!salesData.checkInDate || !salesData.checkOutDate) {
        setError('Giriş ve çıkış tarihleri gereklidir');
        return;
      }

      if (new Date(salesData.checkInDate) >= new Date(salesData.checkOutDate)) {
        setError('Çıkış tarihi giriş tarihinden sonra olmalıdır');
        return;
      }

      // Update sejour object
      const sejourData = {
        id: params.id,
        voucherNumber: salesData.voucherNumber,
        customerType: salesData.customerType,
        agencyId: salesData.agencyId,
        agencyName: salesData.customerType === 'agency' ? agencies.find(a => a.id === salesData.agencyId)?.name : '',
        customerName: salesData.customerName,
        checkInDate: salesData.checkInDate,
        checkOutDate: salesData.checkOutDate,
        rooms: rooms,
        flights: flights,
        transfers: transfers,
        extraServices: extraServices,
        status: salesData.status,
        notes: salesData.notes,
        created_at: new Date().toISOString()
      };

      // Save to localStorage
      const existingData = localStorage.getItem('sejourData');
      const dataArray = existingData ? JSON.parse(existingData) : [];
      const updatedArray = dataArray.map((s: SejourData) => 
        s.id === params.id ? sejourData : s
      );
        localStorage.setItem('sejourData', JSON.stringify(updatedArray));
      
        setSuccess('Sejour başarıyla güncellendi!');
      
      // Redirect after 2 seconds
      setTimeout(() => {
        router.push('/sejour');
      }, 2000);

    } catch (error) {
      console.error('Error updating sejour:', error);
      setError('Sejour güncellenirken bir hata oluştu');
    } finally {
      setSaving(false);
    }
  };

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    handleSave();
  };

  if (loading) {
    return (
      <div className="p-6">
        <div className="text-center py-12">
          <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto"></div>
          <p className="mt-4 text-gray-600">Sejour yükleniyor...</p>
        </div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="p-6">
        <div className="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg">
          {error}
        </div>
        <div className="mt-4">
          <Link
            href="/sejour"
            className="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors"
          >
            Geri Dön
          </Link>
        </div>
      </div>
    );
  }

  return (
    <div className="p-6 bg-gray-50 dark:bg-gray-900 min-h-screen transition-colors duration-200">
      {/* Header */}
      <div className="mb-8">
        <div className="flex items-center text-gray-700 dark:text-gray-300 transition-colors duration-200 justify-between">
          <div>
            <h1 className="text-3xl font-bold text-gray-900 dark:text-white transition-colors duration-200">Sejour Düzenle</h1>
            <p className="text-gray-600 dark:text-gray-400 mt-2 transition-colors duration-200">TEMPUS TRAVEL - MICE Sejour Sistemi</p>
          </div>
          <div className="flex space-x-3">
          <button
              onClick={handleSave}
              disabled={saving}
              className="bg-blue-600 dark:bg-blue-500 text-white px-4 py-2 rounded-md hover:bg-blue-700 dark:hover:bg-blue-600 disabled:opacity-50 disabled:cursor-not-allowed transition-colors duration-200"
            >
              {saving ? 'Kaydediliyor...' : 'Kaydet'}
            </button>
            <Link
              href="/sejour"
            className="px-4 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-md hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors duration-200"
          >
            Geri Dön
            </Link>
        </div>
      </div>
          </div>

      <form onSubmit={handleSubmit}>
      {/* Error and Success Messages */}
      {error && (
        <div className="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-600 text-red-700 dark:text-red-400 px-4 py-3 rounded-lg mb-6 transition-colors duration-200">
          {error}
        </div>
      )}
      {success && (
        <div className="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-600 text-green-700 dark:text-green-400 px-4 py-3 rounded-lg mb-6 transition-colors duration-200">
          {success}
        </div>
      )}

      {/* Tab Navigation */}
      <div className="bg-white dark:bg-gray-800 rounded-lg shadow mb-6 transition-colors duration-200">
          <div className="border-b border-gray-200 dark:border-gray-600">
          <nav className="-mb-px flex space-x-8 px-6">
            {tabs.map((tab) => (
              <button
                key={tab.id}
                  type="button"
                  onClick={() => setActiveTab(tab.id)}
                className={`py-4 px-1 border-b-2 font-medium text-sm transition-colors duration-200 ${
                  activeTab === tab.id
                    ? 'border-blue-500 text-blue-600 dark:text-blue-400'
                      : 'border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 hover:border-gray-300 dark:hover:border-gray-500'
                }`}
              >
                  <div className="flex items-center text-gray-700 dark:text-gray-300 transition-colors duration-200">
                  <span className="mr-2">{tab.icon}</span>
                  {tab.name}
                </div>
              </button>
            ))}
          </nav>
        </div>

        {/* Tab Content */}
          <div className="p-6 bg-white dark:bg-gray-800 transition-colors duration-200">
          {/* Sales Tab */}
          {activeTab === 'sales' && (
            <div className="space-y-6">
              <h2 className="text-xl font-semibold text-gray-900 dark:text-white mb-6 transition-colors duration-200">Satış Rezervasyonu</h2>
              
              {/* Basic Information */}
                <div className="bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-600 rounded-lg p-4 mb-6 transition-colors duration-200">
                <h3 className="text-lg font-medium text-gray-900 dark:text-white mb-4 transition-colors duration-200">Temel Bilgiler</h3>
                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2 transition-colors duration-200">
                      Voucher Numarası *
                    </label>
                    <input
                      type="text"
                      name="voucherNumber"
                      value={salesData.voucherNumber}
                      onChange={handleInputChange}
                      className="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 transition-colors duration-200"
                      placeholder="Voucher numarasını girin"
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2 transition-colors duration-200">
                      Müşteri Tipi *
                    </label>
                    <div className="flex space-x-4">
                      <label className="flex items-center text-gray-700 dark:text-gray-300 transition-colors duration-200">
                        <input
                          type="radio"
                          name="customerType"
                          value="agency"
                          checked={salesData.customerType === 'agency'}
                          onChange={handleInputChange}
                          className="mr-2"
                        />
                        Acente
                      </label>
                      <label className="flex items-center text-gray-700 dark:text-gray-300 transition-colors duration-200">
                        <input
                          type="radio"
                          name="customerType"
                          value="individual"
                          checked={salesData.customerType === 'individual'}
                          onChange={handleInputChange}
                          className="mr-2"
                        />
                        Şahıs
                      </label>
                    </div>
                  </div>
                  <div>
                    {salesData.customerType === 'agency' ? (
                      <>
                        <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2 transition-colors duration-200">
                          Acente Seçimi *
                        </label>
                        <select
                          name="agencyId"
                          value={salesData.agencyId}
                          onChange={handleInputChange}
                            className="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 transition-colors duration-200"
                        >
                          <option value="">Acente seçiniz</option>
                          {agencies.map((agency: any) => (
                            <option key={agency.id} value={agency.id}>
                              {agency.name}
                            </option>
                          ))}
                        </select>
                      </>
                    ) : (
                      <>
                        <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2 transition-colors duration-200">
                          Adı Soyadı *
                        </label>
                        <input
                          type="text"
                          name="customerName"
                          value={salesData.customerName}
                          onChange={handleInputChange}
                            className="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 transition-colors duration-200"
                          placeholder="Müşteri adı soyadı"
                        />
                      </>
                    )}
                  </div>
                  <div className="md:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2 transition-colors duration-200">Giriş Tarihi *</label>
                      <input
                        type="date"
                        name="checkInDate"
                        value={salesData.checkInDate}
                        onChange={handleInputChange}
                          className="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 transition-colors duration-200"
                      />
                    </div>
                    <div>
                      <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2 transition-colors duration-200">Çıkış Tarihi *</label>
                      <input
                        type="date"
                        name="checkOutDate"
                        value={salesData.checkOutDate}
                        onChange={handleInputChange}
                          className="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 transition-colors duration-200"
                      />
                    </div>
                    </div>
                    <div className="md:col-span-2">
                    <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2 transition-colors duration-200">
                      Notlar
                    </label>
                    <textarea
                      name="notes"
                      value={salesData.notes}
                        onChange={handleInputChange}
                      rows={3}
                        className="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 transition-colors duration-200"
                      placeholder="Sejour hakkında notlar..."
                    />
                  </div>
                </div>
              </div>

              {/* Service Buttons */}
              <div className="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
                <button
                  type="button"
                  onClick={() => setShowAccommodation(!showAccommodation)}
                  className="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
                >
                  {showAccommodation ? 'Konaklama Gizle' : 'Oda Ekle'}
                </button>
                <button
                  type="button"
                  onClick={() => setShowFlight(!showFlight)}
                  className="px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors"
                >
                  {showFlight ? 'Uçuş Gizle' : 'Uçuş Ekle'}
                </button>
                <button
                  type="button"
                  onClick={() => setShowTransfer(!showTransfer)}
                  className="px-6 py-3 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors"
                >
                  {showTransfer ? 'Transfer Gizle' : 'Transfer Ekle'}
                </button>
                <button
                  type="button"
                  onClick={() => setShowExtraServices(!showExtraServices)}
                  className="px-6 py-3 bg-orange-600 text-white rounded-lg hover:bg-orange-700 transition-colors"
                >
                  {showExtraServices ? 'Hizmet Gizle' : 'Ekstra Hizmet Ekle'}
                </button>
              </div>

                {/* Accommodation Section */}
              {showAccommodation && (
                  <div className="bg-blue-50 border border-blue-200 rounded-lg p-6 mb-6">
                  <div className="flex justify-between items-center mb-4">
                      <h3 className="text-lg font-medium text-blue-900">Konaklama Bilgileri</h3>
                    <button
                      type="button"
                      onClick={addRoom}
                        className="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors"
                    >
                      + Oda Ekle
                    </button>
                  </div>
                  
                    {rooms.map((room, index) => (
                      <div key={room.id} className="border border-blue-300 rounded-lg p-4 mb-4">
                      <div className="flex justify-between items-center mb-3">
                          <h4 className="font-medium text-blue-800">{room.roomNumber}</h4>
                        <button
                          type="button"
                          onClick={() => removeRoom(room.id)}
                            className="text-red-600 hover:text-red-800"
                        >
                            ✕
                        </button>
                          </div>
                        <div className="flex flex-wrap md:flex-nowrap items-center gap-3 overflow-x-auto">
                            <select
                            className="min-w-[220px] px-3 py-2 border border-blue-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                              value={room.hotelId}
                              onChange={(e) => updateRoom(room.id, 'hotelId', e.target.value)}
                            >
                            <option value="">Otel Seçin</option>
                              {hotels.map((hotel: any) => (
                                <option key={hotel.id} value={hotel.id}>
                                  {hotel.name}
                                </option>
                              ))}
                            </select>
                            <select
                            className="min-w-[140px] px-3 py-2 border border-blue-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                              value={room.accommodationType || ''}
                              onChange={(e) => updateRoom(room.id, 'accommodationType', e.target.value)}
                            >
                            <option value="">Konaklama Tipi</option>
                              {['SNG','DBL','TWN','TRP','QUAD','SNG+CHD','SNG+2CHD','DBL+CHD','DBL+2CHD','TRP+CHD','TRP+2CHD','QUAD+CHD','SNG+INF','DBL+INF','DBL+CHD+INF','TRP+INF'].map(t => (
                                <option key={t} value={t}>{t}</option>
                              ))}
                            </select>
                            <select
                            className="min-w-[140px] px-3 py-2 border border-blue-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                              value={room.roomType}
                              onChange={(e) => updateRoom(room.id, 'roomType', e.target.value)}
                            >
                            <option value="">Oda Tipi</option>
                              {roomTypes.map(type => (
                                <option key={type} value={type}>{type}</option>
                              ))}
                            </select>
                            <input
                            className="min-w-[220px] px-3 py-2 border border-blue-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                              type="text"
                              value={room.guestInfo}
                              onChange={(e) => updateRoom(room.id, 'guestInfo', e.target.value)}
                            placeholder="Misafir Bilgileri"
                            />
                            <input
                            className="w-28 px-3 py-2 border border-blue-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                              type="number"
                            value={room.price}
                              onChange={(e) => updateRoom(room.id, 'price', parseFloat(e.target.value) || 0)}
                            placeholder="Satış Tutarı"
                            />
                            <select
                            className="w-24 px-2 py-2 border border-blue-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                              value={room.currency}
                              onChange={(e) => updateRoom(room.id, 'currency', e.target.value)}
                            >
                              <option value="TRY">TRY</option>
                              <option value="EUR">EUR</option>
                              <option value="USD">USD</option>
                            </select>
                        </div>
                      </div>
                    ))}
                </div>
                )}

                {/* Flight Information */}
                {showFlight && (
                  <div className="bg-green-50 border border-green-200 rounded-lg p-6 mb-6">
                  <div className="flex justify-between items-center mb-4">
                      <h3 className="text-lg font-medium text-green-900">Uçuş Bilgileri</h3>
                    <div className="space-x-2">
                    <button
                      type="button"
                        onClick={() => addFlight('departure')}
                          className="px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 transition-colors"
                      >
                        + Gidiş Uçuşu
                      </button>
                      <button
                        type="button"
                        onClick={() => addFlight('return')}
                          className="px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 transition-colors"
                      >
                        + Dönüş Uçuşu
                    </button>
                  </div>
                </div>

                    {flights.map((flight, index) => (
                      <div key={flight.id} className="border border-green-300 rounded-lg p-4 mb-4">
                      <div className="flex justify-between items-center mb-3">
                          <h4 className="font-medium text-green-800">
                          {flight.type === 'departure' ? 'Gidiş' : 'Dönüş'} Uçuşu {index + 1}
                        </h4>
                        <button
                          type="button"
                          onClick={() => removeFlight(flight.id)}
                            className="text-red-600 hover:text-red-800"
                        >
                            ✕
                        </button>
                          </div>
                      <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                          <div>
                          <label className="block text-sm font-medium text-gray-700 mb-1">Havayolu</label>
                            <input
                              type="text"
                              value={flight.airline}
                              onChange={(e) => updateFlight(flight.id, 'airline', e.target.value)}
                              className="w-full px-3 py-2 border border-green-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
                              placeholder="Havayolu şirketi"
                            />
                          </div>
                          <div>
                          <label className="block text-sm font-medium text-gray-700 mb-1">Rota</label>
                            <input
                              type="text"
                              value={flight.route}
                              onChange={(e) => updateFlight(flight.id, 'route', e.target.value)}
                              className="w-full px-3 py-2 border border-green-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
                              placeholder="Gidiş - Varış"
                            />
                          </div>
                          <div>
                          <label className="block text-sm font-medium text-gray-700 mb-1">Uçuş No</label>
                          <input
                            type="text"
                            value={flight.flightNo}
                            onChange={(e) => updateFlight(flight.id, 'flightNo', e.target.value)}
                              className="w-full px-3 py-2 border border-green-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
                              placeholder="Uçuş numarası"
                          />
                        </div>
                        <div>
                          <label className="block text-sm font-medium text-gray-700 mb-1">Kalkış Saati</label>
                            <input
                              type="time"
                              value={flight.departureTime}
                              onChange={(e) => updateFlight(flight.id, 'departureTime', e.target.value)}
                              className="w-full px-3 py-2 border border-green-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
                            />
                          </div>
                          <div>
                          <label className="block text-sm font-medium text-gray-700 mb-1">Varış Saati</label>
                            <input
                              type="time"
                              value={flight.arrivalTime}
                              onChange={(e) => updateFlight(flight.id, 'arrivalTime', e.target.value)}
                              className="w-full px-3 py-2 border border-green-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
                            />
                          </div>
                          <div>
                          <label className="block text-sm font-medium text-gray-700 mb-1">Fiyat</label>
                            <input
                              type="number"
                            value={flight.price}
                              onChange={(e) => updateFlight(flight.id, 'price', parseFloat(e.target.value) || 0)}
                              className="w-full px-3 py-2 border border-green-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
                              placeholder="0"
                            />
                          </div>
                          </div>
                          </div>
                  ))}
                          </div>
                )}

                {/* Transfer Information */}
                {showTransfer && (
                  <div className="bg-purple-50 border border-purple-200 rounded-lg p-6 mb-6">
                  <div className="flex justify-between items-center mb-4">
                      <h3 className="text-lg font-medium text-purple-900">Transfer Bilgileri</h3>
                    <div className="space-x-2">
                      <button
                        type="button"
                        onClick={() => addTransfer('arrival')}
                          className="px-4 py-2 bg-purple-600 text-white rounded-md hover:bg-purple-700 transition-colors"
                      >
                        + Varış Transferi
                      </button>
                      <button
                        type="button"
                        onClick={() => addTransfer('return')}
                          className="px-4 py-2 bg-purple-600 text-white rounded-md hover:bg-purple-700 transition-colors"
                      >
                        + Dönüş Transferi
                      </button>
                    </div>
                  </div>

                    {transfers.map((transfer, index) => (
                      <div key={transfer.id} className="border border-purple-300 rounded-lg p-4 mb-4">
                      <div className="flex justify-between items-center mb-3">
                          <h4 className="font-medium text-purple-800">
                          {transfer.direction === 'arrival' ? 'Varış' : 'Dönüş'} Transferi {index + 1}
                        </h4>
                        <button
                          type="button"
                          onClick={() => removeTransfer(transfer.id)}
                            className="text-red-600 hover:text-red-800"
                        >
                            ✕
                        </button>
                          </div>
                      <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                          <div>
                            <label className="block text-sm font-medium text-gray-700 mb-1">Tarih</label>
                            <input
                              type="date"
                              value={transfer.date}
                              onChange={(e) => updateTransfer(transfer.id, 'date', e.target.value)}
                              className="w-full px-3 py-2 border border-purple-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500"
                            />
                          </div>
                          <div>
                          <label className="block text-sm font-medium text-gray-700 mb-1">Sağlayıcı</label>
                            <input
                              type="text"
                            value={transfer.provider}
                            onChange={(e) => updateTransfer(transfer.id, 'provider', e.target.value)}
                              className="w-full px-3 py-2 border border-purple-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500"
                              placeholder="Transfer şirketi"
                            />
                          </div>
                          <div>
                            <label className="block text-sm font-medium text-gray-700 mb-1">Tip</label>
                            <select
                              value={transfer.type}
                              onChange={(e) => updateTransfer(transfer.id, 'type', e.target.value)}
                              className="w-full px-3 py-2 border border-purple-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500"
                            >
                              <option value="private">Özel</option>
                              <option value="economic">Ekonomik</option>
                            </select>
                          </div>
                          <div>
                            <label className="block text-sm font-medium text-gray-700 mb-1">Araç</label>
                            <select
                              value={transfer.vehicle}
                              onChange={(e) => updateTransfer(transfer.id, 'vehicle', e.target.value)}
                              className="w-full px-3 py-2 border border-purple-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500"
                          >
                            {vehicleTypes.map(type => (
                              <option key={type} value={type}>{type}</option>
                              ))}
                            </select>
                          </div>
                          <div>
                          <label className="block text-sm font-medium text-gray-700 mb-1">Saat</label>
                            <input
                              type="time"
                              value={transfer.time}
                              onChange={(e) => updateTransfer(transfer.id, 'time', e.target.value)}
                              className="w-full px-3 py-2 border border-purple-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500"
                            />
                          </div>
                          <div>
                          <label className="block text-sm font-medium text-gray-700 mb-1">Fiyat</label>
                            <input
                              type="number"
                            value={transfer.price}
                              onChange={(e) => updateTransfer(transfer.id, 'price', parseFloat(e.target.value) || 0)}
                              className="w-full px-3 py-2 border border-purple-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500"
                              placeholder="0"
                            />
                          </div>
                          </div>
                          </div>
                  ))}
                          </div>
                )}

                {/* Extra Services */}
                {showExtraServices && (
                  <div className="bg-orange-50 border border-orange-200 rounded-lg p-6 mb-6">
                  <div className="flex justify-between items-center mb-4">
                      <h3 className="text-lg font-medium text-orange-900">Ekstra Hizmetler</h3>
                      <button
                        type="button"
                      onClick={addExtraService}
                        className="px-4 py-2 bg-orange-600 text-white rounded-md hover:bg-orange-700 transition-colors"
                      >
                      + Hizmet Ekle
                      </button>
                  </div>
                  
                  {extraServices.map((service, index) => (
                      <div key={service.id} className="border border-orange-300 rounded-lg p-4 mb-4">
                      <div className="flex justify-between items-center mb-3">
                          <h4 className="font-medium text-orange-800">Hizmet {index + 1}</h4>
                      <button
                        type="button"
                          onClick={() => removeExtraService(service.id)}
                            className="text-red-600 hover:text-red-800"
                      >
                            ✕
                      </button>
                    </div>
                      <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                          <div>
                            <label className="block text-sm font-medium text-gray-700 mb-1">Hizmet Tipi</label>
                            <input
                              type="text"
                              value={service.serviceType}
                              onChange={(e) => updateExtraService(service.id, 'serviceType', e.target.value)}
                              className="w-full px-3 py-2 border border-orange-300 rounded-md focus:outline-none focus:ring-2 focus:ring-orange-500"
                              placeholder="Hizmet türü"
                            />
                          </div>
                          <div>
                            <label className="block text-sm font-medium text-gray-700 mb-1">Sağlayıcı</label>
                            <input
                              type="text"
                              value={service.provider}
                              onChange={(e) => updateExtraService(service.id, 'provider', e.target.value)}
                              className="w-full px-3 py-2 border border-orange-300 rounded-md focus:outline-none focus:ring-2 focus:ring-orange-500"
                              placeholder="Hizmet sağlayıcısı"
                            />
                          </div>
                          <div>
                          <label className="block text-sm font-medium text-gray-700 mb-1">Açıklama</label>
                            <input
                              type="text"
                              value={service.description}
                              onChange={(e) => updateExtraService(service.id, 'description', e.target.value)}
                              className="w-full px-3 py-2 border border-orange-300 rounded-md focus:outline-none focus:ring-2 focus:ring-orange-500"
                              placeholder="Hizmet açıklaması"
                            />
                          </div>
                          <div>
                          <label className="block text-sm font-medium text-gray-700 mb-1">Fiyat</label>
                            <input
                              type="number"
                            value={service.price}
                              onChange={(e) => updateExtraService(service.id, 'price', parseFloat(e.target.value) || 0)}
                              className="w-full px-3 py-2 border border-orange-300 rounded-md focus:outline-none focus:ring-2 focus:ring-orange-500"
                              placeholder="0"
                            />
                          </div>
                        </div>
                      </div>
                    ))}
                </div>
              )}
            </div>
          )}

          {/* Purchase Tab */}
          {activeTab === 'purchase' && (
            <div className="space-y-6">
                <div className="bg-blue-50 border border-blue-200 rounded-lg p-6">
                  <h3 className="text-lg font-medium text-blue-900 mb-4">Alış Maliyeti Yönetimi</h3>
                  
                  {/* Oda Maliyetleri */}
                  {rooms.length > 0 && (
                    <div className="mb-6">
                      <h4 className="text-md font-medium text-blue-800 mb-3">Oda Maliyetleri</h4>
                    {rooms.map((room, index) => (
                        <div key={room.id} className="border border-blue-300 rounded-lg p-4 mb-3">
                      <div className="flex justify-between items-center mb-3">
                            <h5 className="font-medium text-blue-700">
                              {room.roomNumber} - {room.roomType}
                            </h5>
                            <span className="text-sm text-blue-600">Misafir: {room.guestInfo}</span>
                          </div>
                          <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
                          <div>
                              <label className="block text-sm font-medium text-gray-700 mb-1">Satış Fiyatı</label>
                              <div className="px-3 py-2 bg-gray-100 rounded-md text-sm">
                                {room.price} {room.currency}
                          </div>
                          </div>
                          <div>
                              <label className="block text-sm font-medium text-gray-700 mb-1">Alış Maliyeti</label>
                            <input
                              type="number"
                              value={room.costPrice || 0}
                              onChange={(e) => updateRoom(room.id, 'costPrice', parseFloat(e.target.value) || 0)}
                                className="w-full px-3 py-2 border border-blue-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                                placeholder="0"
                            />
                          </div>
                          <div>
                              <label className="block text-sm font-medium text-gray-700 mb-1">Para Birimi</label>
                            <select
                                value={room.costCurrency || 'TRY'}
                              onChange={(e) => updateRoom(room.id, 'costCurrency', e.target.value)}
                                className="w-full px-3 py-2 border border-blue-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                              >
                                <option value="TRY">₺ TRY</option>
                                <option value="EUR">€ EUR</option>
                                <option value="USD">$ USD</option>
                            </select>
                          </div>
                        <div>
                              <label className="block text-sm font-medium text-gray-700 mb-1">Kar/Zarar</label>
                          <div className={`px-3 py-2 rounded-md text-sm font-medium ${
                                room.price > 0 && room.costPrice ? 
                                  (room.price - room.costPrice) >= 0 ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'
                                  : 'bg-gray-100 text-gray-600'
                              }`}>
                                {room.price > 0 && room.costPrice ? 
                                  `${(room.price - room.costPrice).toFixed(2)} ${room.currency}` : 
                                  'Hesaplanamadı'
                                }
                        </div>
                      </div>
                            <div className="md:col-span-4">
                              <label className="block text-sm font-medium text-gray-700 mb-1">Kar Marjı (%)</label>
                              <div className={`px-3 py-2 rounded-md text-sm font-medium ${
                                room.price > 0 && room.costPrice ? 
                                  ((room.price - room.costPrice) / room.price * 100) >= 0 ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'
                                  : 'bg-gray-100 text-gray-600'
                              }`}>
                                {room.price > 0 && room.costPrice ? 
                                  `${((room.price - room.costPrice) / room.price * 100).toFixed(1)}%` : 
                                  'Hesaplanamadı'
                            }
                  </div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              )}

                  {/* Uçuş Maliyetleri */}
                  {flights.length > 0 && (
                    <div className="mb-6">
                      <h4 className="text-md font-medium text-blue-800 mb-3">Uçuş Maliyetleri</h4>
                    {flights.map((flight, index) => (
                        <div key={flight.id} className="border border-blue-300 rounded-lg p-4 mb-3">
                      <div className="flex justify-between items-center mb-3">
                            <h5 className="font-medium text-blue-700">
                              {flight.type === 'departure' ? 'Gidiş' : 'Dönüş'} Uçuşu
                            </h5>
                            <span className="text-sm text-blue-600">{flight.airline} - {flight.route}</span>
                          </div>
                          <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
                          <div>
                              <label className="block text-sm font-medium text-gray-700 mb-1">Satış Fiyatı</label>
                              <div className="px-3 py-2 bg-gray-100 rounded-md text-sm">
                                {flight.price} {flight.currency}
                          </div>
                          </div>
                          <div>
                              <label className="block text-sm font-medium text-gray-700 mb-1">Alış Maliyeti</label>
                            <input
                              type="number"
                              value={flight.costPrice || 0}
                              onChange={(e) => updateFlight(flight.id, 'costPrice', parseFloat(e.target.value) || 0)}
                                className="w-full px-3 py-2 border border-blue-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                                placeholder="0"
                            />
                          </div>
                          <div>
                              <label className="block text-sm font-medium text-gray-700 mb-1">Para Birimi</label>
                            <select
                                value={flight.costCurrency || 'EUR'}
                              onChange={(e) => updateFlight(flight.id, 'costCurrency', e.target.value)}
                                className="w-full px-3 py-2 border border-blue-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                              >
                                <option value="TRY">₺ TRY</option>
                                <option value="EUR">€ EUR</option>
                                <option value="USD">$ USD</option>
                            </select>
                          </div>
                        <div>
                              <label className="block text-sm font-medium text-gray-700 mb-1">Kar/Zarar</label>
                          <div className={`px-3 py-2 rounded-md text-sm font-medium ${
                                flight.price > 0 && flight.costPrice ? 
                                  (flight.price - flight.costPrice) >= 0 ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'
                                  : 'bg-gray-100 text-gray-600'
                              }`}>
                                {flight.price > 0 && flight.costPrice ? 
                                  `${(flight.price - flight.costPrice).toFixed(2)} ${flight.currency}` : 
                                  'Hesaplanamadı'
                                }
                        </div>
                      </div>
                            <div className="md:col-span-4">
                              <label className="block text-sm font-medium text-gray-700 mb-1">Kar Marjı (%)</label>
                              <div className={`px-3 py-2 rounded-md text-sm font-medium ${
                                flight.price > 0 && flight.costPrice ? 
                                  ((flight.price - flight.costPrice) / flight.price * 100) >= 0 ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'
                                  : 'bg-gray-100 text-gray-600'
                              }`}>
                                {flight.price > 0 && flight.costPrice ? 
                                  `${((flight.price - flight.costPrice) / flight.price * 100).toFixed(1)}%` : 
                                  'Hesaplanamadı'
                            }
                    </div>
                  </div>
                      </div>
                    </div>
                  ))}
                </div>
              )}

                  {/* Transfer Maliyetleri */}
                  {transfers.length > 0 && (
                    <div className="mb-6">
                      <h4 className="text-md font-medium text-blue-800 mb-3">Transfer Maliyetleri</h4>
                    {transfers.map((transfer, index) => (
                        <div key={transfer.id} className="border border-blue-300 rounded-lg p-4 mb-3">
                      <div className="flex justify-between items-center mb-3">
                            <h5 className="font-medium text-blue-700">
                              {transfer.direction === 'arrival' ? 'Varış' : 'Dönüş'} Transferi
                            </h5>
                            <span className="text-sm text-blue-600">{transfer.provider} - {transfer.vehicle}</span>
                          </div>
                          <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
                          <div>
                              <label className="block text-sm font-medium text-gray-700 mb-1">Satış Fiyatı</label>
                              <div className="px-3 py-2 bg-gray-100 rounded-md text-sm">
                                {transfer.price} {transfer.currency}
                          </div>
                          </div>
                          <div>
                              <label className="block text-sm font-medium text-gray-700 mb-1">Alış Maliyeti</label>
                            <input
                              type="number"
                              value={transfer.costPrice || 0}
                              onChange={(e) => updateTransfer(transfer.id, 'costPrice', parseFloat(e.target.value) || 0)}
                                className="w-full px-3 py-2 border border-blue-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                                placeholder="0"
                            />
                          </div>
                          <div>
                              <label className="block text-sm font-medium text-gray-700 mb-1">Para Birimi</label>
                            <select
                                value={transfer.costCurrency || 'EUR'}
                              onChange={(e) => updateTransfer(transfer.id, 'costCurrency', e.target.value)}
                                className="w-full px-3 py-2 border border-blue-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                              >
                                <option value="TRY">₺ TRY</option>
                                <option value="EUR">€ EUR</option>
                                <option value="USD">$ USD</option>
                            </select>
                          </div>
                        <div>
                              <label className="block text-sm font-medium text-gray-700 mb-1">Kar/Zarar</label>
                          <div className={`px-3 py-2 rounded-md text-sm font-medium ${
                                transfer.price > 0 && transfer.costPrice ? 
                                  (transfer.price - transfer.costPrice) >= 0 ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'
                                  : 'bg-gray-100 text-gray-600'
                              }`}>
                                {transfer.price > 0 && transfer.costPrice ? 
                                  `${(transfer.price - transfer.costPrice).toFixed(2)} ${transfer.currency}` : 
                                  'Hesaplanamadı'
                                }
                        </div>
                      </div>
                            <div className="md:col-span-4">
                              <label className="block text-sm font-medium text-gray-700 mb-1">Kar Marjı (%)</label>
                              <div className={`px-3 py-2 rounded-md text-sm font-medium ${
                                transfer.price > 0 && transfer.costPrice ? 
                                  ((transfer.price - transfer.costPrice) / transfer.price * 100) >= 0 ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'
                                  : 'bg-gray-100 text-gray-600'
                              }`}>
                                {transfer.price > 0 && transfer.costPrice ? 
                                  `${((transfer.price - transfer.costPrice) / transfer.price * 100).toFixed(1)}%` : 
                                  'Hesaplanamadı'
                            }
                    </div>
                  </div>
                      </div>
                    </div>
                  ))}
                </div>
              )}

                  {/* Ekstra Hizmet Maliyetleri */}
                  {extraServices.length > 0 && (
                    <div className="mb-6">
                      <h4 className="text-md font-medium text-blue-800 mb-3">Ekstra Hizmet Maliyetleri</h4>
                    {extraServices.map((service, index) => (
                        <div key={service.id} className="border border-blue-300 rounded-lg p-4 mb-3">
                      <div className="flex justify-between items-center mb-3">
                            <h5 className="font-medium text-blue-700">{service.serviceType}</h5>
                            <span className="text-sm text-blue-600">{service.provider}</span>
                          </div>
                          <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
                          <div>
                              <label className="block text-sm font-medium text-gray-700 mb-1">Satış Fiyatı</label>
                              <div className="px-3 py-2 bg-gray-100 rounded-md text-sm">
                                {service.price} {service.currency}
                          </div>
                          </div>
                          <div>
                              <label className="block text-sm font-medium text-gray-700 mb-1">Alış Maliyeti</label>
                            <input
                              type="number"
                              value={service.costPrice || 0}
                              onChange={(e) => updateExtraService(service.id, 'costPrice', parseFloat(e.target.value) || 0)}
                                className="w-full px-3 py-2 border border-blue-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                                placeholder="0"
                            />
                          </div>
                          <div>
                              <label className="block text-sm font-medium text-gray-700 mb-1">Para Birimi</label>
                            <select
                                value={service.costCurrency || 'TRY'}
                              onChange={(e) => updateExtraService(service.id, 'costCurrency', e.target.value)}
                                className="w-full px-3 py-2 border border-blue-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                              >
                                <option value="TRY">₺ TRY</option>
                                <option value="EUR">€ EUR</option>
                                <option value="USD">$ USD</option>
                            </select>
                          </div>
                            <div>
                              <label className="block text-sm font-medium text-gray-700 mb-1">Kar/Zarar</label>
                          <div className={`px-3 py-2 rounded-md text-sm font-medium ${
                                service.price > 0 && service.costPrice ? 
                                  (service.price - service.costPrice) >= 0 ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'
                                  : 'bg-gray-100 text-gray-600'
                              }`}>
                                {service.price > 0 && service.costPrice ? 
                                  `${(service.price - service.costPrice).toFixed(2)} ${service.currency}` : 
                                  'Hesaplanamadı'
                                }
                        </div>
                      </div>
                            <div className="md:col-span-4">
                              <label className="block text-sm font-medium text-gray-700 mb-1">Kar Marjı (%)</label>
                              <div className={`px-3 py-2 rounded-md text-sm font-medium ${
                                service.price > 0 && service.costPrice ? 
                                  ((service.price - service.costPrice) / service.price * 100) >= 0 ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'
                                  : 'bg-gray-100 text-gray-600'
                              }`}>
                                {service.price > 0 && service.costPrice ? 
                                  `${((service.price - service.costPrice) / service.price * 100).toFixed(1)}%` : 
                                  'Hesaplanamadı'
                            }
                  </div>
                </div>
                    </div>
                  </div>
                  ))}
                    </div>
                  )}

                  {/* Toplam Maliyet ve Kar Özeti */}
                  <div className="bg-blue-100 border border-blue-300 rounded-lg p-4">
                    <h4 className="text-md font-medium text-blue-800 mb-3">Toplam Maliyet ve Kar Özeti</h4>
                    <div className="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
                      <div className="bg-white p-3 rounded-lg border">
                        <span className="font-medium block mb-1">TRY:</span>
                        <div className="text-xs space-y-1">
                          <div>Maliyet: {rooms.reduce((sum, room) => sum + (room.costPrice && room.costCurrency === 'TRY' ? room.costPrice : 0), 0) +
                           flights.reduce((sum, flight) => sum + (flight.costPrice && flight.costCurrency === 'TRY' ? flight.costPrice : 0), 0) +
                           transfers.reduce((sum, transfer) => sum + (transfer.costPrice && transfer.costCurrency === 'TRY' ? transfer.costPrice : 0), 0) +
                           extraServices.reduce((sum, service) => sum + (service.costPrice && service.costCurrency === 'TRY' ? service.costPrice : 0), 0)}</div>
                          <div>Kar: {rooms.reduce((sum, room) => sum + (room.price && room.costPrice && room.costCurrency === 'TRY' ? room.price - room.costPrice : 0), 0) +
                           flights.reduce((sum, flight) => sum + (flight.price && flight.costPrice && flight.costCurrency === 'TRY' ? flight.price - flight.costPrice : 0), 0) +
                           transfers.reduce((sum, transfer) => sum + (transfer.price && transfer.costPrice && transfer.costCurrency === 'TRY' ? transfer.price - transfer.costPrice : 0), 0) +
                           extraServices.reduce((sum, service) => sum + (service.price && service.costPrice && service.costCurrency === 'TRY' ? service.price - service.costPrice : 0), 0)}</div>
                  </div>
                    </div>
                      <div className="bg-white p-3 rounded-lg border">
                        <span className="font-medium block mb-1">EUR:</span>
                        <div className="text-xs space-y-1">
                          <div>Maliyet: {rooms.reduce((sum, room) => sum + (room.costPrice && room.costCurrency === 'EUR' ? room.costPrice : 0), 0) +
                           flights.reduce((sum, flight) => sum + (flight.costPrice && flight.costCurrency === 'EUR' ? flight.costPrice : 0), 0) +
                           transfers.reduce((sum, transfer) => sum + (transfer.costPrice && transfer.costCurrency === 'EUR' ? transfer.costPrice : 0), 0) +
                           extraServices.reduce((sum, service) => sum + (service.costPrice && service.costCurrency === 'EUR' ? service.costPrice : 0), 0)}</div>
                          <div>Kar: {rooms.reduce((sum, room) => sum + (room.price && room.costPrice && room.costCurrency === 'EUR' ? room.price - room.costPrice : 0), 0) +
                           flights.reduce((sum, flight) => sum + (flight.price && flight.costPrice && flight.costCurrency === 'EUR' ? flight.price - flight.costPrice : 0), 0) +
                           transfers.reduce((sum, transfer) => sum + (transfer.price && transfer.costPrice && transfer.costCurrency === 'EUR' ? transfer.price - transfer.costPrice : 0), 0) +
                           extraServices.reduce((sum, service) => sum + (service.price && service.costPrice && service.costCurrency === 'EUR' ? service.price - service.costPrice : 0), 0)}</div>
                  </div>
                </div>
                      <div className="bg-white p-3 rounded-lg border">
                        <span className="font-medium block mb-1">USD:</span>
                        <div className="text-xs space-y-1">
                          <div>Maliyet: {rooms.reduce((sum, room) => sum + (room.costPrice && room.costCurrency === 'USD' ? room.costPrice : 0), 0) +
                           flights.reduce((sum, flight) => sum + (flight.price && flight.costPrice && flight.costCurrency === 'USD' ? flight.costPrice : 0), 0) +
                           transfers.reduce((sum, transfer) => sum + (transfer.costPrice && transfer.costCurrency === 'USD' ? transfer.costPrice : 0), 0) +
                           extraServices.reduce((sum, service) => sum + (service.costPrice && service.costCurrency === 'USD' ? service.costPrice : 0), 0)}</div>
                          <div>Kar: {rooms.reduce((sum, room) => sum + (room.price && room.costPrice && room.costCurrency === 'USD' ? room.price - room.costPrice : 0), 0) +
                           flights.reduce((sum, flight) => sum + (flight.price && flight.costPrice && flight.costCurrency === 'USD' ? flight.price - flight.costPrice : 0), 0) +
                           transfers.reduce((sum, transfer) => sum + (transfer.price && transfer.costPrice && transfer.costCurrency === 'USD' ? transfer.price - transfer.costPrice : 0), 0) +
                           extraServices.reduce((sum, service) => sum + (service.price && service.costPrice && service.costCurrency === 'USD' ? service.price - service.costPrice : 0), 0)}</div>
              </div>
                  </div>
                  </div>
                  </div>
              </div>
            </div>
          )}

          {/* Collections Tab */}
          {activeTab === 'collections' && (
              <div className="text-center py-8">
                <p className="text-gray-500 mb-4">Tahsilat yönetimi için bir sejour seçin</p>
                </div>
              )}
              

              </div>
                    </div>
      </form>
    </div>
  );
} 