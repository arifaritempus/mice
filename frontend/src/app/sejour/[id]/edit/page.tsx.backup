'use client';

import { useState, useEffect } from 'react';
import { useRouter, useParams } from 'next/navigation';
import { useTheme } from '@/components/providers/ThemeProvider';

interface Room {
  id: string;
  roomNumber: string;
  hotelId: string;
  accommodationType?: string;
  roomType: string;
  guestInfo: string;
  price: number;
  currency: string;
  // Alış maliyeti için yeni alanlar
  costPrice?: number;
  costCurrency?: string;
}

interface FlightInfo {
  id: string;
  flightDate: string;
  airline: string;
  route: string;
  flightNo: string;
  departureTime: string;
  arrivalTime: string;
  price: number;
  currency: string;
  type: 'departure' | 'return';
  // Biletleme alanları
  ticketingDate: string;
  ticketingProvider: string;
  pnr: string;
  // Alış maliyeti için yeni alanlar
  costPrice?: number;
  costCurrency?: string;
}

interface TransferInfo {
  id: string;
  date: string;
  provider: string;
  type: 'private' | 'economic';
  vehicle: string;
  time: string;
  price: number;
  currency: string;
  direction: 'arrival' | 'return';
  // Alış maliyeti için yeni alanlar
  costPrice?: number;
  costCurrency?: string;
}

interface ExtraService {
  id: string;
  serviceType: string;
  provider: string;
  description: string;
  price: number;
  currency: string;
  // Alış maliyeti için alanlar (sadece alış tab'ında kullanılır)
  costPrice?: number;
  costCurrency?: string;
}

interface Collection {
  id: string;
  type: string;
  amount: number;
  date: string;
  description: string;
  currency: string;
}



export default function EditSejourPage() {
  const { isDark } = useTheme();
  const router = useRouter();
  const params = useParams();
  const sejourId = params.id as string;
  const [activeTab, setActiveTab] = useState('sales');
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');
  const [success, setSuccess] = useState('');

  // Sales Form Data
  const [salesData, setSalesData] = useState({
    voucherNumber: '',
    customerType: 'agency', // 'agency' or 'individual'
    agencyId: '',
    customerName: '',
    checkInDate: '',
    checkOutDate: '',
    totalAmount: 0,
    currency: 'TRY',
    status: 'BEKLEMEDE',
    notes: ''
  });

  // Rooms
  const [rooms, setRooms] = useState<Room[]>([]);

  // Flight Info
  const [flights, setFlights] = useState<FlightInfo[]>([]);

  // Transfer Info
  const [transfers, setTransfers] = useState<TransferInfo[]>([]);

  // Extra Services
  const [extraServices, setExtraServices] = useState<ExtraService[]>([]);

  // Collections
  const [collections, setCollections] = useState<Collection[]>([]);

  // Service Price Input State for TR formatting
  const [servicePriceInput, setServicePriceInput] = useState<Record<string, string>>({});



  // Real Data States
  const [agencies, setAgencies] = useState<any[]>([]);
  const [hotels, setHotels] = useState<any[]>([]);
  const [suppliers, setSuppliers] = useState<any[]>([]);
  const [supplierServiceTypes, setSupplierServiceTypes] = useState<any[]>([]);

  const [roomTypes] = useState([
    'Standart Oda', 'Kara Manzaralı', 'Deniz Manzaralı', 'Kısmi Deniz Manzaralı',
    'Suite', 'King Suite', 'Villa', 'Deluxe Oda', 'Executive Suite'
  ]);

  const [vehicleTypes] = useState([
    'Vito', 'Binek', 'S Class', 'Sprinter', 'Otobüs'
  ]);

  // Load real data from localStorage
  useEffect(() => {
    // Load agencies
    let storedAgencies = JSON.parse(localStorage.getItem('agencies') || '[]');
    if (storedAgencies.length === 0) {
      storedAgencies = [
        { id: '1', name: 'ABC Turizm' },
        { id: '2', name: 'XYZ Seyahat' },
        { id: '3', name: 'Delta Tours' },
        { id: '4', name: 'Golden Travel' }
      ];
      localStorage.setItem('agencies', JSON.stringify(storedAgencies));
    }
    setAgencies(storedAgencies);

    // Load hotels
    let storedHotels = JSON.parse(localStorage.getItem('hotels') || '[]');
    if (storedHotels.length === 0) {
      storedHotels = [
        { id: '1', name: 'Grand Hotel Antalya' },
        { id: '2', name: 'Blue Palace Resort' },
        { id: '3', name: 'Seaside Hotel' },
        { id: '4', name: 'Mountain View Lodge' },
        { id: '5', name: 'City Center Hotel' }
      ];
      localStorage.setItem('hotels', JSON.stringify(storedHotels));
    }
    setHotels(storedHotels);

    // Load suppliers
    let storedSuppliers = JSON.parse(localStorage.getItem('suppliers') || '[]');
    if (storedSuppliers.length === 0) {
      storedSuppliers = [
        { id: '1', name: 'Antalya Transfer', type: 'transfer' },
        { id: '2', name: 'Luxury Transfer', type: 'transfer' },
        { id: '3', name: 'VIP Transfer', type: 'transfer' },
        { id: '4', name: 'Tour Guide Service', type: 'service' },
        { id: '5', name: 'Event Organizer', type: 'service' }
      ];
      localStorage.setItem('suppliers', JSON.stringify(storedSuppliers));
    }
    setSuppliers(storedSuppliers);

    // Load supplier service types from Service Types management storage
    let storedServiceTypes = JSON.parse(localStorage.getItem('serviceTypes') || '[]');
    if (storedServiceTypes.length === 0) {
      // Seed with the same defaults used in the Service Types page
      storedServiceTypes = [
        {
          id: '1',
          name: 'Transfer',
          code: 'TRANSFER',
          description: 'Havaalanı, otel ve şehirler arası transfer hizmetleri',
          is_active: true,
          notes: '',
          created_at: new Date().toISOString(),
          updated_at: new Date().toISOString()
        },
        {
          id: '2',
          name: 'Kokartlı Rehber',
          code: 'GUIDE',
          description: 'Profesyonel kokartlı rehber hizmetleri',
          is_active: true,
          notes: '',
          created_at: new Date().toISOString(),
          updated_at: new Date().toISOString()
        },
        {
          id: '3',
          name: 'Otel',
          code: 'HOTEL',
          description: 'Konaklama ve otel hizmetleri',
          is_active: true,
          notes: '',
          created_at: new Date().toISOString(),
          updated_at: new Date().toISOString()
        },
        {
          id: '4',
          name: 'Restoran',
          code: 'RESTAURANT',
          description: 'Yemek ve restoran hizmetleri',
          is_active: true,
          notes: '',
          created_at: new Date().toISOString(),
          updated_at: new Date().toISOString()
        },
        {
          id: '5',
          name: 'Eğlence',
          code: 'ENTERTAINMENT',
          description: 'Eğlence ve aktivite hizmetleri',
          is_active: true,
          notes: '',
          created_at: new Date().toISOString(),
          updated_at: new Date().toISOString()
        },
        {
          id: '6',
          name: 'Ulaşım',
          code: 'TRANSPORT',
          description: 'Genel ulaşım hizmetleri',
          is_active: true,
          notes: '',
          created_at: new Date().toISOString(),
          updated_at: new Date().toISOString()
        },
        {
          id: '7',
          name: 'Diğer',
          code: 'OTHER',
          description: 'Diğer hizmet türleri',
          is_active: true,
          notes: '',
          created_at: new Date().toISOString(),
          updated_at: new Date().toISOString()
        }
      ];
      localStorage.setItem('serviceTypes', JSON.stringify(storedServiceTypes));
    }
    const activeServiceTypes = storedServiceTypes.filter((st: any) => st.is_active !== false);
    setSupplierServiceTypes(activeServiceTypes);
  }, []);

  // Load existing sejour data
  useEffect(() => {
    if (sejourId) {
      const existingSejours = JSON.parse(localStorage.getItem('sejourData') || '[]');
      const sejour = existingSejours.find((s: any) => s.id === sejourId);
      
      if (sejour) {
        setSalesData({
          voucherNumber: sejour.voucherNumber || '',
          customerType: sejour.customerType || 'agency',
          agencyId: sejour.agencyId || '',
          customerName: sejour.customerName || '',
          checkInDate: sejour.checkInDate || '',
          checkOutDate: sejour.checkOutDate || '',
          totalAmount: sejour.totalAmount || 0,
          currency: sejour.currency || 'EUR',
          status: sejour.status || 'BEKLEMEDE',
          notes: sejour.notes || ''
        });
        
        if (sejour.rooms) {
          setRooms(sejour.rooms);
          if (sejour.rooms.length > 0) setShowAccommodation(true);
        }
        if (sejour.flights) {
          setFlights(sejour.flights);
          if (sejour.flights.length > 0) setShowFlight(true);
        }
        if (sejour.transfers) {
          setTransfers(sejour.transfers);
          if (sejour.transfers.length > 0) setShowTransfer(true);
        }
        if (sejour.extraServices) {
          setExtraServices(sejour.extraServices);
          if (sejour.extraServices.length > 0) setShowExtraServices(true);
        }
        if (sejour.collections) {
          // Mevcut tahsilatlarda currency yoksa ekle
          const collectionsWithCurrency = sejour.collections.map((collection: any) => ({
            ...collection,
            currency: collection.currency || 'TRY'
          }));
          setCollections(collectionsWithCurrency);
        }
      }
    }
  }, [sejourId]);

  // Section visibility states
  const [showAccommodation, setShowAccommodation] = useState(false);
  const [showFlight, setShowFlight] = useState(false);
  const [showTransfer, setShowTransfer] = useState(false);
  const [showExtraServices, setShowExtraServices] = useState(false);

  const handleInputChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>) => {
    const { name, value } = e.target;
    setSalesData(prev => ({
      ...prev,
      [name]: value
    }));
  };

  const handleNumberChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const { name, value } = e.target;
    setSalesData(prev => ({
      ...prev,
      [name]: parseFloat(value) || 0
    }));
  };

  // Room Management
  const addRoom = () => {
    const newRoom: Room = {
      id: Date.now().toString(),
      roomNumber: `Oda ${rooms.length + 1}`,
      hotelId: '',
      accommodationType: '',
      roomType: '',
      guestInfo: '',
      price: 0,
      currency: 'TRY',
      costPrice: 0,
      costCurrency: 'TRY'
    };
    setRooms([...rooms, newRoom]);
  };

  // Flight Management
  const addFlight = (type: 'departure' | 'return') => {
    const newFlight: FlightInfo = {
      id: Date.now().toString(),
      flightDate: type === 'departure' ? salesData.checkInDate : salesData.checkOutDate,
      airline: '',
      route: '',
      flightNo: '',
      departureTime: '',
      arrivalTime: '',
      price: 0,
      currency: 'TRY',
      type: type,
      ticketingDate: new Date().toISOString().split('T')[0], // Bugünün tarihi
      ticketingProvider: '',
      pnr: '',
      costPrice: 0,
      costCurrency: 'TRY'
    };
    setFlights([...flights, newFlight]);
  };

  const updateFlight = (id: string, field: keyof FlightInfo, value: string | number) => {
    setFlights(flights.map(flight => 
      flight.id === id ? { ...flight, [field]: value } : flight
    ));
  };

  const removeFlight = (id: string) => {
    setFlights(flights.filter(flight => flight.id !== id));
  };

  // Transfer Management
  const addTransfer = (direction: 'arrival' | 'return') => {
    const newTransfer: TransferInfo = {
      id: Date.now().toString(),
      date: direction === 'arrival' ? salesData.checkInDate : salesData.checkOutDate,
      provider: '',
      type: 'private',
      vehicle: '',
      time: '',
      price: 0,
      currency: 'TRY',
      direction: direction,
      costPrice: 0,
      costCurrency: 'TRY'
    };
    setTransfers([...transfers, newTransfer]);
  };

  const updateTransfer = (id: string, field: keyof TransferInfo, value: string | number) => {
    setTransfers(transfers.map(transfer => 
      transfer.id === id ? { ...transfer, [field]: value } : transfer
    ));
  };

  const removeTransfer = (id: string) => {
    setTransfers(transfers.filter(transfer => transfer.id !== id));
  };

  const updateRoom = (id: string, field: keyof Room, value: string | number) => {
    setRooms(rooms.map(room => 
      room.id === id ? { ...room, [field]: value } : room
    ));
  };

  const removeRoom = (id: string) => {
    setRooms(rooms.filter(room => room.id !== id));
  };

  // Extra Service Management
  const addExtraService = () => {
    const newService: ExtraService = {
      id: Date.now().toString(),
      serviceType: '',
      provider: '',
      description: '',
      price: 0,
      currency: 'TRY',
      costPrice: 0,
      costCurrency: 'TRY'
    };
    setExtraServices([...extraServices, newService]);
  };

  const updateExtraService = (id: string, field: keyof ExtraService, value: string | number) => {
    setExtraServices(extraServices.map(service => 
      service.id === id ? { ...service, [field]: value } : service
    ));
  };

  const removeExtraService = (id: string) => {
    setExtraServices(extraServices.filter(service => service.id !== id));
  };

  // TR format helper
  const formatAmount = (value: number) => new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(value);
  
  // TR format input helpers
  const normalizeTyping = (value: string) => value.replace(/[^\d,]/g, '').replace(/,/g, '.');
  
  const parseTrAmount = (value: string): number | null => {
    if (!value) return null;
    const normalized = value.replace(/\./g, '').replace(/,/g, '.');
    const parsed = parseFloat(normalized);
    return isNaN(parsed) ? null : parsed;
  };

  // Currency options in order
  const CURRENCY_OPTIONS = ['TRY', 'EUR', 'USD', 'GBP'];

  // Calculate total amount by currency
  const calculateTotalAmount = () => {
    const totals = {
      TRY: 0,
      EUR: 0,
      USD: 0,
      GBP: 0
    } as Record<string, number>;

    // Room totals
    rooms.forEach(room => {
      totals[room.currency as keyof typeof totals] += room.price;
    });

    // Flight totals
    flights.forEach(flight => {
      totals[flight.currency as keyof typeof totals] += flight.price;
    });

    // Transfer totals
    transfers.forEach(transfer => {
      totals[transfer.currency as keyof typeof totals] += transfer.price;
    });

    // Service totals
    extraServices.forEach(service => {
      totals[service.currency as keyof typeof totals] += service.price;
    });

    return totals;
  };

  // Calculate total cost by currency
  const calculateTotalCost = () => {
    const costs = {
      TRY: 0,
      EUR: 0,
      USD: 0,
      GBP: 0
    } as Record<string, number>;

    // Room costs
    rooms.forEach(room => {
      const costCurrency = room.costCurrency || room.currency;
      costs[costCurrency as keyof typeof costs] += room.costPrice || 0;
    });

    // Flight costs
    flights.forEach(flight => {
      const costCurrency = flight.costCurrency || flight.currency;
      costs[costCurrency as keyof typeof costs] += flight.costPrice || 0;
    });

    // Transfer costs
    transfers.forEach(transfer => {
      const costCurrency = transfer.costCurrency || transfer.currency;
      costs[costCurrency as keyof typeof costs] += transfer.costPrice || 0;
    });

    // Service costs
    extraServices.forEach(service => {
      const costCurrency = service.costCurrency || service.currency;
      costs[costCurrency as keyof typeof costs] += service.costPrice || 0;
    });

    return costs;
  };

  // Get total for specific currency
  const getTotalForCurrency = (currency: string) => {
    const totals = calculateTotalAmount();
    return totals[currency as keyof typeof totals] || 0;
  };

  // Get cost for specific currency
  const getCostForCurrency = (currency: string) => {
    const costs = calculateTotalCost();
    return costs[currency as keyof typeof costs] || 0;
  };

  // Calculate profit/loss for specific currency
  const getProfitForCurrency = (currency: string) => {
    const total = getTotalForCurrency(currency);
    const cost = getCostForCurrency(currency);
    return total - cost;
  };

  // Collections Management
  const addCollection = () => {
    const newCollection: Collection = {
      id: Date.now().toString(),
      type: 'cash', // Varsayılan olarak nakit seçili
      amount: 0,
      date: new Date().toISOString().split('T')[0], // Bugünün tarihi
      description: '',
      currency: 'TRY' // Varsayılan olarak TRY
    };
    setCollections([...collections, newCollection]);
  };

  const updateCollection = (id: string, field: keyof Collection, value: string | number) => {
    setCollections(collections.map(collection => 
      collection.id === id ? { ...collection, [field]: value } : collection
    ));
  };

  const removeCollection = (id: string) => {
    setCollections(collections.filter(collection => collection.id !== id));
  };

  const calculateTotalCollections = () => {
    return collections.reduce((sum, collection) => sum + collection.amount, 0);
  };

  const calculateTotalCollectionsByCurrency = (currency: string) => {
    return collections
      .filter(collection => collection.currency === currency)
      .reduce((sum, collection) => sum + collection.amount, 0);
  };

  const calculateBalance = () => {
    const totalAmount = getTotalForCurrency(salesData.currency);
    return totalAmount - calculateTotalCollections();
  };

  const calculateBalanceByCurrency = (currency: string) => {
    const totalAmount = getTotalForCurrency(currency);
    const totalCollections = calculateTotalCollectionsByCurrency(currency);
    return totalAmount - totalCollections;
  };



  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setLoading(true);
    setError('');
    setSuccess('');

    try {
      // Validation
      if (!salesData.voucherNumber.trim()) {
        setError('Voucher numarası gereklidir');
        return;
      }

      if (!salesData.agencyId) {
        setError('Acente seçimi gereklidir');
        return;
      }

      if (!salesData.checkInDate || !salesData.checkOutDate) {
        setError('Giriş ve çıkış tarihleri gereklidir');
        return;
      }

      if (new Date(salesData.checkInDate) >= new Date(salesData.checkOutDate)) {
        setError('Çıkış tarihi giriş tarihinden sonra olmalıdır');
        return;
      }

      // Update existing sejour object
      const sejourData = {
        id: sejourId,
        voucherNumber: salesData.voucherNumber,
        customerType: salesData.customerType,
        agencyId: salesData.agencyId,
        agencyName: salesData.customerType === 'agency' ? agencies.find(a => a.id === salesData.agencyId)?.name : '',
        customerName: salesData.customerName,
        checkInDate: salesData.checkInDate,
        checkOutDate: salesData.checkOutDate,
        rooms: rooms,
        flights: flights,
        transfers: transfers,
        extraServices: extraServices,
        totals: calculateTotalAmount(),
        costs: calculateTotalCost(),
        profits: {
          TRY: getProfitForCurrency('TRY'),
          EUR: getProfitForCurrency('EUR'),
          USD: getProfitForCurrency('USD'),
          GBP: getProfitForCurrency('GBP')
        },
        currency: salesData.currency,
        status: salesData.status,
        notes: salesData.notes,
        collections: collections,
        updated_at: new Date().toISOString()
      };

      // Update localStorage
      const existingData = localStorage.getItem('sejourData');
      const dataArray = existingData ? JSON.parse(existingData) : [];
      const existingIndex = dataArray.findIndex((s: any) => s.id === sejourId);
      
      if (existingIndex !== -1) {
        dataArray[existingIndex] = sejourData;
      } else {
        dataArray.push(sejourData);
      }
      
      localStorage.setItem('sejourData', JSON.stringify(dataArray));
      
      // Debug: localStorage'a kaydedilen veriyi kontrol et
      console.log('Sejour updated and saved to localStorage:', {
        sejourData,
        dataArray,
        localStorageKey: 'sejourData',
        totalSejours: dataArray.length
      });

      // Also update sejourSales for listing
      const existingSejourSales = JSON.parse(localStorage.getItem('sejourSales') || '[]');
      const totals = calculateTotalAmount();
      
      // En yüksek tutarlı para birimini bul
      const mainCurrency = Object.entries(totals).reduce((a, b) => totals[a[0] as keyof typeof totals] > totals[b[0] as keyof typeof totals] ? a : b)[0];
      
      const sejourSale = {
        id: sejourData.id,
        voucherNumber: sejourData.voucherNumber,
        customerType: sejourData.customerType,
        customerName: sejourData.customerName,
        agencyName: sejourData.agencyName,
        checkInDate: sejourData.checkInDate,
        checkOutDate: sejourData.checkOutDate,
        totalAmount: totals[mainCurrency as keyof typeof totals] || 0,
        currency: mainCurrency,
        status: sejourData.status,
        updated_at: sejourData.updated_at
      };
      
      const existingSaleIndex = existingSejourSales.findIndex((s: any) => s.id === sejourId);
      if (existingSaleIndex !== -1) {
        existingSejourSales[existingSaleIndex] = sejourSale;
      } else {
        existingSejourSales.push(sejourSale);
      }
      localStorage.setItem('sejourSales', JSON.stringify(existingSejourSales));

      setSuccess('Sejour başarıyla güncellendi!');
      
      // Redirect after 2 seconds
      setTimeout(() => {
        router.push('/sejour');
      }, 2000);

    } catch (error) {
      console.error('Error updating sejour:', error);
      setError('Sejour güncellenirken bir hata oluştu');
    } finally {
      setLoading(false);
    }
  };

  const tabs = [
    { id: 'sales', name: 'SATIŞ', icon: '💰' },
    { id: 'purchase', name: 'ALIŞ', icon: '🛒' },
    { id: 'collections', name: 'TAHSİLAT', icon: '💳' }
  ];

  return (
    <div className="p-6 bg-gray-50 dark:bg-gray-900 min-h-screen transition-colors duration-200">
      {/* Header */}
      <div className="mb-8">
        <div className="flex items-center justify-between">
          <div>
            <h1 className="text-3xl font-bold text-gray-900 dark:text-white transition-colors duration-200">Sejour Düzenle</h1>
            <p className="text-gray-600 dark:text-gray-400 mt-2 transition-colors duration-200">TEMPUS TRAVEL - MICE Sejour Sistemi</p>
          </div>
          <button
            onClick={() => router.push('/sejour')}
            className="px-4 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-md hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors duration-200"
          >
            Geri Dön
          </button>
        </div>
      </div>


        {/* Error and Success Messages */}
        {error && (
          <div className="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-700 text-red-700 dark:text-red-200 px-4 py-3 rounded-lg mb-6 transition-colors duration-200">
            {error}
          </div>
        )}
        {success && (
          <div className="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-700 text-green-700 dark:text-green-200 px-4 py-3 rounded-lg mb-6 transition-colors duration-200">
            {success}
          </div>
        )}

        {/* Tab Navigation */}
        <div className="bg-white dark:bg-gray-800 rounded-lg shadow mb-6 transition-colors duration-200">
          <div className="border-b border-gray-200 dark:border-gray-700">
            <nav className="-mb-px flex space-x-8 px-6">
              {tabs.map((tab) => (
                              <button
                key={tab.id}
                type="button"
                onClick={() => setActiveTab(tab.id)}
                className={`py-4 px-1 border-b-2 font-medium text-sm transition-colors duration-200 ${
                  activeTab === tab.id
                    ? 'border-blue-500 dark:border-blue-400 text-blue-600 dark:text-blue-400'
                    : 'border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 hover:border-gray-300 dark:hover:border-gray-600'
                }`}
              >
                  <div className="flex items-center">
                    <span className="mr-2">{tab.icon}</span>
                    {tab.name}
                  </div>
                </button>
              ))}
            </nav>
          </div>

          {/* Tab Content */}
          <div className="p-6">
            {/* Sales Tab */}
            {activeTab === 'sales' && (
              <div className="space-y-6">
                <h2 className="text-xl font-semibold text-gray-900 dark:text-white mb-6 transition-colors duration-200">Satış Rezervasyonu</h2>
                
                {/* Basic Information */}
                <div className="bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-lg p-4 mb-6 transition-colors duration-200">
                  <h3 className="text-lg font-medium text-gray-900 dark:text-white mb-4 transition-colors duration-200">Temel Bilgiler</h3>
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2 transition-colors duration-200">
                        Voucher Numarası *
                      </label>
                      <input
                        type="text"
                        name="voucherNumber"
                        value={salesData.voucherNumber}
                        onChange={handleInputChange}
                        className="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 transition-colors duration-200"
                        placeholder="Voucher numarasını girin"
                      />
                    </div>
                    <div>
                      <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2 transition-colors duration-200">
                        Müşteri Tipi *
                      </label>
                      <div className="flex space-x-4">
                        <label className="flex items-center text-gray-700 dark:text-gray-300 transition-colors duration-200">
                          <input
                            type="radio"
                            name="customerType"
                            value="agency"
                            checked={salesData.customerType === 'agency'}
                            onChange={handleInputChange}
                            className="mr-2 text-blue-600 dark:text-blue-400 focus:ring-blue-500 dark:focus:ring-blue-400 transition-colors duration-200"
                          />
                          Acente
                        </label>
                        <label className="flex items-center text-gray-700 dark:text-gray-300 transition-colors duration-200">
                          <input
                            type="radio"
                            name="customerType"
                            value="individual"
                            checked={salesData.customerType === 'individual'}
                            onChange={handleInputChange}
                            className="mr-2 text-blue-600 dark:text-blue-400 focus:ring-blue-500 dark:focus:ring-blue-400 transition-colors duration-200"
                          />
                          Şahıs
                        </label>
                      </div>
                    </div>
                    <div>
                      {salesData.customerType === 'agency' ? (
                        <>
                          <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2 transition-colors duration-200">
                            Acente Seçimi *
                          </label>
                          <select
                            name="agencyId"
                            value={salesData.agencyId}
                            onChange={handleInputChange}
                            className="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white transition-colors duration-200"
                          >
                            <option value="">Acente Seçin</option>
                            {agencies.map((agency: any) => (
                              <option key={agency.id} value={agency.id}>
                                {agency.name}
                              </option>
                            ))}
                          </select>
                        </>
                      ) : (
                        <>
                          <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2 transition-colors duration-200">
                            Adı Soyadı *
                          </label>
                          <input
                            type="text"
                            name="customerName"
                            value={salesData.customerName}
                            onChange={handleInputChange}
                            className="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 transition-colors duration-200"
                            placeholder="Müşteri adı soyadı"
                          />
                        </>
                      )}
                    </div>
                    <div className="md:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-4">
                      <div>
                        <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2 transition-colors duration-200">Giriş Tarihi *</label>
                        <input
                          type="date"
                          name="checkInDate"
                          value={salesData.checkInDate}
                          onChange={handleInputChange}
                          className="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white transition-colors duration-200"
                        />
                      </div>
                      <div>
                        <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2 transition-colors duration-200">Çıkış Tarihi *</label>
                        <input
                          type="date"
                          name="checkOutDate"
                          value={salesData.checkOutDate}
                          onChange={handleInputChange}
                          className="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white transition-colors duration-200"
                        />
                      </div>
                      <div>
                        <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2 transition-colors duration-200">Rezervasyon Durumu</label>
                        <select
                          name="status"
                          value={salesData.status}
                          onChange={handleInputChange}
                          className="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white transition-colors duration-200"
                        >
                          <option value="BEKLEMEDE">Beklemede</option>
                          <option value="KONFIRME">Konfirme</option>
                          <option value="İPTAL">İptal</option>
                        </select>
                      </div>
                    </div>
                  </div>
                </div>

                {/* Service Buttons */}
                <div className="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
                  <button
                    type="button"
                    onClick={() => setShowAccommodation(!showAccommodation)}
                    className="px-6 py-3 bg-blue-600 dark:bg-blue-500 text-white rounded-lg hover:bg-blue-700 dark:hover:bg-blue-600 transition-colors duration-200"
                  >
                    {showAccommodation ? 'Konaklama Gizle' : 'Oda Ekle'}
                  </button>
                  <button
                    type="button"
                    onClick={() => setShowFlight(!showFlight)}
                    className="px-6 py-3 bg-green-600 dark:bg-green-500 text-white rounded-lg hover:bg-green-700 dark:hover:bg-green-600 transition-colors duration-200"
                  >
                    {showFlight ? 'Uçuş Gizle' : 'Uçuş Ekle'}
                  </button>
                  <button
                    type="button"
                    onClick={() => setShowTransfer(!showTransfer)}
                    className="px-6 py-3 bg-purple-600 dark:bg-purple-500 text-white rounded-lg hover:bg-purple-700 dark:hover:bg-purple-600 transition-colors duration-200"
                  >
                    {showTransfer ? 'Transfer Gizle' : 'Transfer Ekle'}
                  </button>
                  <button
                    type="button"
                    onClick={() => setShowExtraServices(!showExtraServices)}
                    className="px-6 py-3 bg-orange-600 dark:bg-orange-500 text-white rounded-lg hover:bg-orange-700 dark:hover:bg-orange-600 transition-colors duration-200"
                  >
                    {showExtraServices ? 'Hizmet Gizle' : 'Ekstra Hizmet Ekle'}
                  </button>
                </div>

                {/* Accommodation Section */}
                {showAccommodation && (
                  <div className="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-700 rounded-lg p-6 mb-6 transition-colors duration-200">
                    <div className="flex justify-between items-center mb-4">
                      <h3 className="text-lg font-medium text-blue-900 dark:text-blue-100 transition-colors duration-200">Konaklama Bilgileri</h3>
                      <button
                        type="button"
                        onClick={addRoom}
                        className="px-4 py-2 bg-blue-600 dark:bg-blue-500 text-white rounded-md hover:bg-blue-700 dark:hover:bg-blue-600 transition-colors duration-200"
                      >
                        + Oda Ekle
                      </button>
                    </div>
                    
                    {rooms.map((room, index) => (
                      <div key={room.id} className="border border-blue-300 dark:border-blue-600 rounded-lg p-4 mb-4 bg-white dark:bg-gray-700 transition-colors duration-200">
                        <div className="flex justify-between items-center mb-3">
                          <h4 className="font-medium text-blue-800 dark:text-blue-200 transition-colors duration-200">{room.roomNumber}</h4>
                          <button
                            type="button"
                            onClick={() => removeRoom(room.id)}
                            className="text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300 transition-colors duration-200"
                          >
                            ✕
                          </button>
                        </div>
                        <div className="flex flex-wrap md:flex-nowrap items-center gap-3 justify-between">
                          <div className="flex-1 min-w-0">
                            <label className="block text-xs font-medium text-blue-700 dark:text-blue-300 mb-1 transition-colors duration-200">Otel</label>
                            <select
                              className="w-full px-3 py-2 text-sm border border-blue-300 dark:border-blue-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white transition-colors duration-200"
                              value={room.hotelId}
                              onChange={(e) => updateRoom(room.id, 'hotelId', e.target.value)}
                            >
                              <option value="">Otel Seçin</option>
                              {hotels.map((hotel: any) => (
                                <option key={hotel.id} value={hotel.id}>
                                  {hotel.name}
                                </option>
                              ))}
                            </select>
                          </div>
                          <div className="flex-1 min-w-0">
                            <label className="block text-xs font-medium text-blue-700 dark:text-blue-300 mb-1 transition-colors duration-200">Konaklama Tipi</label>
                            <select
                              className="w-full px-3 py-2 text-sm border border-blue-300 dark:border-blue-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white transition-colors duration-200"
                              value={room.accommodationType || ''}
                              onChange={(e) => updateRoom(room.id, 'accommodationType', e.target.value)}
                            >
                              <option value="">Konaklama Tipi</option>
                              {['SNG','DBL','TWN','TRP','QUAD','SNG+CHD','SNG+2CHD','DBL+CHD','DBL+2CHD','TRP+CHD','TRP+2CHD','QUAD+CHD','SNG+INF','DBL+INF','DBL+CHD+INF','TRP+INF'].map(t => (
                                <option key={t} value={t}>{t}</option>
                              ))}
                            </select>
                          </div>
                          <div className="flex-1 min-w-0">
                            <label className="block text-xs font-medium text-blue-700 dark:text-blue-300 mb-1 transition-colors duration-200">Oda Tipi</label>
                            <select
                              className="w-full px-3 py-2 text-sm border border-blue-300 dark:border-blue-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white transition-colors duration-200"
                              value={room.roomType}
                              onChange={(e) => updateRoom(room.id, 'roomType', e.target.value)}
                            >
                              <option value="">Oda Tipi</option>
                              {roomTypes.map(type => (
                                <option key={type} value={type}>{type}</option>
                              ))}
                            </select>
                          </div>
                          <div className="flex-1 min-w-0">
                            <label className="block text-xs font-medium text-blue-700 dark:text-blue-300 mb-1 transition-colors duration-200">Misafir</label>
                            <input
                              className="w-full px-3 py-2 text-sm border border-blue-300 dark:border-blue-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 transition-colors duration-200"
                              type="text"
                              value={room.guestInfo}
                              onChange={(e) => updateRoom(room.id, 'guestInfo', e.target.value)}
                              placeholder="Misafir Bilgileri"
                            />
                          </div>
                          <div className="flex-1 min-w-0">
                            <label className="block text-xs font-medium text-blue-700 dark:text-blue-300 mb-1 transition-colors duration-200">Satış Tutarı</label>
                            <input
                              className="w-full px-3 py-2 text-sm border border-blue-300 dark:border-blue-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 transition-colors duration-200"
                              type="text"
                              inputMode="decimal"
                              value={servicePriceInput[room.id] ?? (room.price ? formatAmount(room.price) : '')}
                              onChange={(e) => setServicePriceInput(prev => ({...prev, [room.id]: normalizeTyping(e.target.value)}))}
                              onBlur={(e) => {
                                const parsed = parseTrAmount(servicePriceInput[room.id] ?? e.target.value);
                                if (parsed !== null) {
                                  updateRoom(room.id, 'price', parsed);
                                  setServicePriceInput(prev => ({...prev, [room.id]: formatAmount(parsed)}));
                                }
                              }}
                              placeholder="Satış Tutarı"
                            />
                          </div>
                          <div className="flex-1 min-w-0">
                            <label className="block text-xs font-medium text-blue-700 dark:text-blue-300 mb-1 transition-colors duration-200">Döviz</label>
                            <select
                              className="w-full px-3 py-2 text-sm border border-blue-300 dark:border-blue-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white transition-colors duration-200"
                              value={room.currency}
                              onChange={(e) => updateRoom(room.id, 'currency', e.target.value)}
                            >
                              <option value="TRY">TRY</option>
                              <option value="EUR">EUR</option>
                              <option value="USD">USD</option>
                              <option value="GBP">GBP</option>
                            </select>
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                )}

                {/* Flight Information */}
                {showFlight && (
                  <div className="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-700 rounded-lg p-6 mb-6 transition-colors duration-200">
                    <div className="flex justify-between items-center mb-4">
                      <h3 className="text-lg font-medium text-green-900 dark:text-green-100 transition-colors duration-200">Uçuş Bilgileri</h3>
                      <div className="space-x-2">
                        <button
                          type="button"
                          onClick={() => addFlight('departure')}
                          className="px-4 py-2 bg-green-600 dark:bg-green-500 text-white rounded-md hover:bg-green-700 dark:hover:bg-green-600 transition-colors duration-200"
                        >
                          + Gidiş Uçuşu
                        </button>
                        <button
                          type="button"
                          onClick={() => addFlight('return')}
                          className="px-4 py-2 bg-green-600 dark:bg-green-500 text-white rounded-md hover:bg-green-700 dark:hover:bg-green-600 transition-colors duration-200"
                        >
                          + Dönüş Uçuşu
                        </button>
                      </div>
                    </div>
                    
                    {flights.map((flight, index) => (
                      <div key={flight.id} className="border border-green-300 dark:border-green-600 rounded-lg p-4 mb-4 bg-white dark:bg-gray-700 transition-colors duration-200">
                        <div className="flex justify-between items-center mb-3">
                          <h4 className="font-medium text-green-800 dark:text-green-200 transition-colors duration-200">
                            {flight.type === 'departure' ? 'Gidiş' : 'Dönüş'} Uçuşu {index + 1}
                          </h4>
                          <button
                            type="button"
                            onClick={() => removeFlight(flight.id)}
                            className="text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300 transition-colors duration-200"
                          >
                            ✕
                          </button>
                        </div>
                        <div className="flex flex-wrap md:flex-nowrap items-center gap-3 justify-between">
                            <div className="flex-1 min-w-0">
                              <label className="block text-xs font-medium text-green-700 dark:text-green-300 mb-1 transition-colors duration-200">Tarih</label>
                              <input
                                type="date"
                                value={flight.flightDate}
                                onChange={(e) => updateFlight(flight.id, 'flightDate', e.target.value)}
                                className="w-full px-3 py-2 text-sm border border-green-300 dark:border-green-600 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white transition-colors duration-200"
                              />
                            </div>
                            <div className="flex-1 min-w-0">
                              <label className="block text-xs font-medium text-green-700 dark:text-green-300 mb-1 transition-colors duration-200">Havayolu</label>
                              <input
                                type="text"
                                value={flight.airline}
                                onChange={(e) => updateFlight(flight.id, 'airline', e.target.value)}
                                className="w-full px-3 py-2 text-sm border border-green-300 dark:border-green-600 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 transition-colors duration-200"
                                placeholder="Havayolu"
                              />
                            </div>
                            <div className="flex-1 min-w-0">
                              <label className="block text-xs font-medium text-green-700 dark:text-green-300 mb-1 transition-colors duration-200">Güzergah</label>
                              <input
                                type="text"
                                value={flight.route}
                                onChange={(e) => updateFlight(flight.id, 'route', e.target.value)}
                                className="w-full px-3 py-2 text-sm border border-green-300 dark:border-green-600 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 transition-colors duration-200"
                                placeholder="Güzergah"
                              />
                            </div>
                            <div className="flex-1 min-w-0">
                              <label className="block text-xs font-medium text-green-700 dark:text-green-300 mb-1 transition-colors duration-200">Uçuş No</label>
                              <input
                                type="text"
                                value={flight.flightNo}
                                onChange={(e) => updateFlight(flight.id, 'flightNo', e.target.value)}
                                className="w-full px-3 py-2 text-sm border border-green-300 dark:border-green-600 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 transition-colors duration-200"
                                placeholder="Uçuş No"
                              />
                            </div>
                            <div className="flex-1 min-w-0">
                              <label className="block text-xs font-medium text-green-700 dark:text-green-300 mb-1 transition-colors duration-200">Kalkış</label>
                              <input
                                type="time"
                                value={flight.departureTime}
                                onChange={(e) => updateFlight(flight.id, 'departureTime', e.target.value)}
                                className="w-full px-3 py-2 text-sm border border-green-300 dark:border-green-600 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white transition-colors duration-200"
                              />
                            </div>
                            <div className="flex-1 min-w-0">
                              <label className="block text-xs font-medium text-green-700 dark:text-green-300 mb-1 transition-colors duration-200">Varış</label>
                              <input
                                type="time"
                                value={flight.arrivalTime}
                                onChange={(e) => updateFlight(flight.id, 'arrivalTime', e.target.value)}
                                className="w-full px-3 py-2 text-sm border border-green-300 dark:border-green-600 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white transition-colors duration-200"
                              />
                            </div>
                            <div className="flex-1 min-w-0">
                              <label className="block text-xs font-medium text-green-700 dark:text-green-300 mb-1 transition-colors duration-200">Biletleme Tarihi</label>
                              <input
                                type="date"
                                value={flight.ticketingDate}
                                onChange={(e) => updateFlight(flight.id, 'ticketingDate', e.target.value)}
                                className="w-full px-3 py-2 text-sm border border-green-300 dark:border-green-600 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white transition-colors duration-200"
                              />
                            </div>
                            <div className="flex-1 min-w-0">
                              <label className="block text-xs font-medium text-green-700 dark:text-green-300 mb-1 transition-colors duration-200">Tedarikçi</label>
                              <select
                                value={flight.ticketingProvider}
                                onChange={(e) => updateFlight(flight.id, 'ticketingProvider', e.target.value)}
                                className="w-full px-3 py-2 text-sm border border-green-300 dark:border-green-600 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white transition-colors duration-200"
                              >
                                <option value="">Tedarikçi Seçin</option>
                                {suppliers.map(supplier => (
                                  <option key={supplier.id} value={supplier.id}>
                                    {supplier.name}
                                  </option>
                                ))}
                              </select>
                            </div>
                            <div className="flex-1 min-w-0">
                              <label className="block text-xs font-medium text-green-700 dark:text-green-300 mb-1 transition-colors duration-200">PNR</label>
                              <input
                                type="text"
                                value={flight.pnr}
                                onChange={(e) => updateFlight(flight.id, 'pnr', e.target.value)}
                                className="w-full px-3 py-2 text-sm border border-green-300 dark:border-green-600 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 transition-colors duration-200"
                                placeholder="PNR"
                              />
                            </div>
                            <div className="flex-1 min-w-0">
                              <label className="block text-xs font-medium text-green-700 dark:text-green-300 mb-1 transition-colors duration-200">Fiyat</label>
                              <input
                                type="text"
                                inputMode="decimal"
                                value={servicePriceInput[`flight_${flight.id}`] ?? (flight.price ? formatAmount(flight.price) : '')}
                                onChange={(e) => setServicePriceInput(prev => ({...prev, [`flight_${flight.id}`]: normalizeTyping(e.target.value)}))}
                                onBlur={(e) => {
                                  const parsed = parseTrAmount(servicePriceInput[`flight_${flight.id}`] ?? e.target.value);
                                  if (parsed !== null) {
                                    updateFlight(flight.id, 'price', parsed);
                                    setServicePriceInput(prev => ({...prev, [`flight_${flight.id}`]: formatAmount(parsed)}));
                                  }
                                }}
                                className="w-full px-3 py-2 text-sm border border-green-300 dark:border-green-600 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 transition-colors duration-200"
                                placeholder="Fiyat"
                              />
                            </div>
                            <div className="flex-1 min-w-0">
                              <label className="block text-xs font-medium text-green-700 dark:text-green-300 mb-1 transition-colors duration-200">Döviz</label>
                              <select
                                value={flight.currency}
                                onChange={(e) => updateFlight(flight.id, 'currency', e.target.value)}
                                className="w-full px-3 py-2 text-sm border border-green-300 dark:border-green-600 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white transition-colors duration-200"
                              >
                                <option value="TRY">TRY</option>
                                <option value="EUR">EUR</option>
                                <option value="USD">USD</option>
                                <option value="GBP">GBP</option>
                              </select>
                            </div>
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                )}

                {/* Transfer Information */}
                {showTransfer && (
                  <div className="bg-purple-50 dark:bg-purple-900/20 border border-purple-200 dark:border-purple-700 rounded-lg p-6 mb-6 transition-colors duration-200">
                    <div className="flex justify-between items-center mb-4">
                      <h3 className="text-lg font-medium text-purple-900 dark:text-purple-100 transition-colors duration-200">Transfer Bilgileri</h3>
                      <div className="space-x-2">
                        <button
                          type="button"
                          onClick={() => addTransfer('arrival')}
                          className="px-4 py-2 bg-purple-600 dark:bg-purple-500 text-white rounded-md hover:bg-purple-700 dark:hover:bg-purple-600 transition-colors duration-200"
                        >
                          + Geliş Transferi
                        </button>
                        <button
                          type="button"
                          onClick={() => addTransfer('return')}
                          className="px-4 py-2 bg-purple-600 dark:bg-purple-500 text-white rounded-md hover:bg-purple-700 dark:hover:bg-purple-600 transition-colors duration-200"
                        >
                          + Dönüş Transferi
                        </button>
                      </div>
                    </div>
                    
                    {transfers.map((transfer, index) => (
                      <div key={transfer.id} className="border border-purple-300 dark:border-purple-600 rounded-lg p-4 mb-4 bg-white dark:bg-gray-700 transition-colors duration-200">
                        <div className="flex justify-between items-center mb-3">
                          <h4 className="font-medium text-purple-800 dark:text-purple-200 transition-colors duration-200">
                            {transfer.direction === 'arrival' ? 'Geliş' : 'Dönüş'} Transferi {index + 1}
                          </h4>
                          <button
                            type="button"
                            onClick={() => removeTransfer(transfer.id)}
                            className="text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300 transition-colors duration-200"
                          >
                            ✕
                          </button>
                        </div>
                        <div className="flex flex-wrap md:flex-nowrap items-center gap-3 justify-between">
                          <div className="flex-1 min-w-0">
                            <label className="block text-xs font-medium text-purple-700 dark:text-purple-300 mb-1 transition-colors duration-200">Tarih</label>
                            <input
                              className="w-full px-3 py-2 text-sm border border-purple-300 dark:border-purple-600 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500 dark:focus:ring-purple-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white transition-colors duration-200"
                              type="date"
                              value={transfer.date}
                              onChange={(e) => updateTransfer(transfer.id, 'date', e.target.value)}
                            />
                          </div>
                          <div className="flex-1 min-w-0">
                            <label className="block text-xs font-medium text-purple-700 dark:text-purple-300 mb-1 transition-colors duration-200">Tedarikçi</label>
                            <select
                              className="w-full px-3 py-2 text-sm border border-purple-300 dark:border-purple-600 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500 dark:focus:ring-purple-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white transition-colors duration-200"
                              value={transfer.provider}
                              onChange={(e) => updateTransfer(transfer.id, 'provider', e.target.value)}
                            >
                              <option value="">Tedarikçi Seçin</option>
                               {(() => {
                                 const store = JSON.parse(localStorage.getItem('suppliers') || '[]');
                                 const list = Array.isArray(store) ? store : suppliers;
                                 return list
                                   .filter((s: any) => (s.type === 'transfer' || !s.type))
                                   .map((supplier: any) => (
                                     <option key={supplier.id} value={supplier.id}>
                                       {supplier.name}
                                     </option>
                                   ));
                               })()}
                            </select>
                          </div>
                          <div className="flex-1 min-w-0">
                            <label className="block text-xs font-medium text-purple-700 dark:text-purple-300 mb-1 transition-colors duration-200">Tip</label>
                            <select
                              className="w-full px-3 py-2 text-sm border border-purple-300 dark:border-purple-600 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500 dark:focus:ring-purple-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white transition-colors duration-200"
                              value={transfer.type}
                              onChange={(e) => updateTransfer(transfer.id, 'type', e.target.value)}
                            >
                              <option value="private">Özel</option>
                              <option value="economic">Ekonomik</option>
                            </select>
                          </div>
                          <div className="flex-1 min-w-0">
                            <label className="block text-xs font-medium text-purple-700 dark:text-purple-300 mb-1 transition-colors duration-200">Araç</label>
                            <select
                              className="w-full px-3 py-2 text-sm border border-purple-300 dark:border-purple-600 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500 dark:focus:ring-purple-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white transition-colors duration-200"
                              value={transfer.vehicle}
                              onChange={(e) => updateTransfer(transfer.id, 'vehicle', e.target.value)}
                            >
                              <option value="">Araç Tipi</option>
                              {vehicleTypes.map(type => (
                                <option key={type} value={type}>{type}</option>
                              ))}
                            </select>
                          </div>
                          <div className="flex-1 min-w-0">
                            <label className="block text-xs font-medium text-purple-700 dark:text-purple-300 mb-1 transition-colors duration-200">Saat</label>
                            <input
                              className="w-full px-3 py-2 text-sm border border-purple-300 dark:border-purple-600 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500 dark:focus:ring-purple-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white transition-colors duration-200"
                              type="time"
                              value={transfer.time}
                              onChange={(e) => updateTransfer(transfer.id, 'time', e.target.value)}
                            />
                          </div>
                          <div className="flex-1 min-w-0">
                            <label className="block text-xs font-medium text-purple-700 dark:text-purple-300 mb-1 transition-colors duration-200">Satış Tutarı</label>
                            <input
                              type="text"
                              inputMode="decimal"
                              value={servicePriceInput[`transfer_${transfer.id}`] ?? (transfer.price ? formatAmount(transfer.price) : '')}
                              onChange={(e) => setServicePriceInput(prev => ({...prev, [`transfer_${transfer.id}`]: normalizeTyping(e.target.value)}))}
                              onBlur={(e) => {
                                const parsed = parseTrAmount(servicePriceInput[`transfer_${transfer.id}`] ?? e.target.value);
                                if (parsed !== null) {
                                  updateTransfer(transfer.id, 'price', parsed);
                                  setServicePriceInput(prev => ({...prev, [`transfer_${transfer.id}`]: formatAmount(parsed)}));
                                }
                              }}
                              className="w-full px-3 py-2 text-sm border border-purple-300 dark:border-purple-600 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500 dark:focus:ring-purple-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 transition-colors duration-200"
                              placeholder="Tutar"
                            />
                          </div>
                          <div className="flex-1 min-w-0">
                            <label className="block text-xs font-medium text-purple-700 dark:text-purple-300 mb-1 transition-colors duration-200">Döviz</label>
                            <select
                              value={transfer.currency}
                              onChange={(e) => updateTransfer(transfer.id, 'currency', e.target.value)}
                              className="w-full px-3 py-2 text-sm border border-purple-300 dark:border-purple-600 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500 dark:focus:ring-purple-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white transition-colors duration-200"
                            >
                              <option value="TRY">TRY</option>
                              <option value="EUR">EUR</option>
                              <option value="USD">USD</option>
                              <option value="GBP">GBP</option>
                            </select>
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                )}

                {/* Extra Services */}
                {showExtraServices && (
                  <div className="bg-orange-50 dark:bg-orange-900/20 border border-orange-200 dark:border-orange-700 rounded-lg p-4 mb-6 transition-colors duration-200">
                    <div className="flex justify-between items-center mb-4">
                      <h3 className="text-lg font-medium text-orange-900 dark:text-orange-100 transition-colors duration-200">Ekstra Hizmetler</h3>
                      <button
                        type="button"
                        onClick={addExtraService}
                        className="px-4 py-2 bg-orange-600 dark:bg-orange-500 text-white rounded-md hover:bg-orange-700 dark:hover:bg-orange-600 transition-colors duration-200"
                      >
                        + Hizmet Ekle
                      </button>
                    </div>
                    
                    {extraServices.map((service, index) => (
                      <div key={service.id} className="border border-orange-300 dark:border-orange-600 rounded-lg p-4 mb-3 bg-white dark:bg-gray-700 transition-colors duration-200">
                        <div className="flex justify-between items-center mb-3">
                          <h4 className="font-medium text-orange-800 dark:text-orange-200 transition-colors duration-200">Hizmet {index + 1}</h4>
                          <button
                            type="button"
                            onClick={() => removeExtraService(service.id)}
                            className="text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300 transition-colors duration-200"
                          >
                            ✕
                          </button>
                        </div>
                        <div className="flex flex-wrap md:flex-nowrap items-center gap-3 justify-between">
                          <div className="flex-1 min-w-0">
                            <label className="block text-xs font-medium text-orange-700 dark:text-orange-300 mb-1 transition-colors duration-200">Hizmet Tipi</label>
                            <select
                              value={service.serviceType}
                              onChange={(e) => updateExtraService(service.id, 'serviceType', e.target.value)}
                              className="w-full px-3 py-2 text-sm border border-orange-300 dark:border-orange-600 rounded-md focus:outline-none focus:ring-2 focus:ring-orange-500 dark:focus:ring-orange-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white transition-colors duration-200"
                            >
                              <option value="">Hizmet Tipi Seçin</option>
                              {supplierServiceTypes.map(type => (
                                <option key={type.id} value={type.id}>
                                  {type.name}
                                </option>
                              ))}
                            </select>
                          </div>
                          <div className="flex-1 min-w-0">
                            <label className="block text-xs font-medium text-orange-700 dark:text-orange-300 mb-1 transition-colors duration-200">Tedarikçi</label>
                            <select
                              value={service.provider}
                              onChange={(e) => updateExtraService(service.id, 'provider', e.target.value)}
                              className="w-full px-3 py-2 text-sm border border-orange-300 dark:border-orange-600 rounded-md focus:outline-none focus:ring-2 focus:ring-orange-500 dark:focus:ring-orange-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white transition-colors duration-200"
                            >
                              <option value="">Tedarikçi Seçin</option>
                              {suppliers.map(supplier => (
                                <option key={supplier.id} value={supplier.id}>
                                  {supplier.name}
                                </option>
                              ))}
                            </select>
                          </div>
                          <div className="flex-1 min-w-0">
                            <label className="block text-xs font-medium text-orange-700 dark:text-orange-300 mb-1 transition-colors duration-200">Açıklama</label>
                            <input
                              type="text"
                              value={service.description}
                              onChange={(e) => updateExtraService(service.id, 'description', e.target.value)}
                              className="w-full px-3 py-2 text-sm border border-orange-300 dark:border-orange-600 rounded-md focus:outline-none focus:ring-2 focus:ring-orange-500 dark:focus:ring-orange-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 transition-colors duration-200"
                              placeholder="Açıklama"
                            />
                          </div>
                          <div className="flex-1 min-w-0">
                            <label className="block text-xs font-medium text-orange-700 dark:text-orange-300 mb-1 transition-colors duration-200">Satış Fiyatı</label>
                            <input
                              type="text"
                              inputMode="decimal"
                              value={servicePriceInput[`extra_${service.id}`] ?? (service.price ? formatAmount(service.price) : '')}
                              onChange={(e) => setServicePriceInput(prev => ({...prev, [`extra_${service.id}`]: normalizeTyping(e.target.value)}))}
                              onBlur={(e) => {
                                const parsed = parseTrAmount(servicePriceInput[`extra_${service.id}`] ?? e.target.value);
                                if (parsed !== null) {
                                  updateExtraService(service.id, 'price', parsed);
                                  setServicePriceInput(prev => ({...prev, [`extra_${service.id}`]: formatAmount(parsed)}));
                                }
                              }}
                              className="w-full px-3 py-2 text-sm border border-orange-300 dark:border-orange-600 rounded-md focus:outline-none focus:ring-2 focus:ring-orange-500 dark:focus:ring-orange-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 transition-colors duration-200"
                              placeholder="Satış Fiyatı"
                            />
                          </div>
                          <div className="flex-1 min-w-0">
                            <label className="block text-xs font-medium text-orange-700 dark:text-orange-300 mb-1 transition-colors duration-200">Döviz</label>
                            <select
                              value={service.currency}
                              onChange={(e) => updateExtraService(service.id, 'currency', e.target.value)}
                              className="w-full px-3 py-2 text-sm border border-orange-300 dark:border-orange-600 rounded-md focus:outline-none focus:ring-2 focus:ring-orange-500 dark:focus:ring-orange-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white transition-colors duration-200"
                            >
                              <option value="TRY">TRY</option>
                              <option value="EUR">EUR</option>
                              <option value="USD">USD</option>
                              <option value="GBP">GBP</option>
                            </select>
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                )}

                {/* Summary */}
                <div className="bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-lg p-4 transition-colors duration-200">
                  <h3 className="text-lg font-medium text-gray-900 dark:text-white mb-4 transition-colors duration-200">Özet</h3>
                  <div className="grid grid-cols-1 md:grid-cols-4 gap-6">
                    <div className="bg-blue-50 dark:bg-blue-900/20 p-4 rounded-lg transition-colors duration-200">
                      <h4 className="text-sm font-medium text-blue-900 dark:text-blue-100 transition-colors duration-200">Toplam Tutarlar</h4>
                      <div className="space-y-1">
                        <p className="text-lg font-bold text-blue-600 dark:text-blue-400 transition-colors duration-200">TRY: {formatAmount(getTotalForCurrency('TRY'))}</p>
                        <p className="text-lg font-bold text-blue-600 dark:text-blue-400 transition-colors duration-200">EUR: {formatAmount(getTotalForCurrency('EUR'))}</p>
                        <p className="text-lg font-bold text-blue-600 dark:text-blue-400 transition-colors duration-200">USD: {formatAmount(getTotalForCurrency('USD'))}</p>
                        <p className="text-lg font-bold text-blue-600 dark:text-blue-400 transition-colors duration-200">GBP: {formatAmount(getTotalForCurrency('GBP'))}</p>
                      </div>
                    </div>
                    <div className="bg-green-50 dark:bg-green-900/20 p-4 rounded-lg transition-colors duration-200">
                      <h4 className="text-sm font-medium text-green-900 dark:text-green-100 transition-colors duration-200">Oda Sayısı</h4>
                      <p className="text-2xl font-bold text-green-600 dark:text-green-400 transition-colors duration-200">{rooms.length}</p>
                    </div>
                    <div className="bg-purple-50 dark:bg-purple-900/20 p-4 rounded-lg transition-colors duration-200">
                      <h4 className="text-sm font-medium text-purple-900 dark:text-purple-100 transition-colors duration-200">Uçuş Sayısı</h4>
                      <p className="text-2xl font-bold text-purple-600 dark:text-purple-400 transition-colors duration-200">{flights.length}</p>
                    </div>
                    <div className="bg-orange-50 dark:bg-orange-900/20 p-4 rounded-lg transition-colors duration-200">
                      <h4 className="text-sm font-medium text-orange-900 dark:text-orange-100 transition-colors duration-200">Transfer Sayısı</h4>
                      <p className="text-2xl font-bold text-orange-600 dark:text-orange-400 transition-colors duration-200">{transfers.length}</p>
                    </div>
                  </div>
                </div>
              </div>
            )}

            {/* Purchase Tab */}
            {activeTab === 'purchase' && (
              <div className="space-y-6">
                <h2 className="text-xl font-semibold text-gray-900 dark:text-white mb-6 transition-colors duration-200">Alış Rezervasyonu - Maliyet Yönetimi</h2>
                
                {/* Basic Information (Same as Sales) */}
                <div className="bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-lg p-4 mb-6 transition-colors duration-200">
                  <h3 className="text-lg font-medium text-gray-900 dark:text-white mb-4 transition-colors duration-200">Temel Bilgiler</h3>
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2 transition-colors duration-200">
                        Voucher Numarası *
                      </label>
                      <input
                        type="text"
                        value={salesData.voucherNumber}
                        className="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-gray-100 dark:bg-gray-600 text-gray-900 dark:text-white transition-colors duration-200"
                        readOnly
                      />
                    </div>
                    <div>
                      <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2 transition-colors duration-200">
                        Acente Seçimi *
                      </label>
                      <input
                        type="text"
                        value={agencies.find(a => a.id === salesData.agencyId)?.name || ''}
                        className="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-gray-100 dark:bg-gray-600 text-gray-900 dark:text-white transition-colors duration-200"
                        readOnly
                      />
                    </div>
                    <div>
                      <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2 transition-colors duration-200">
                        Giriş Tarihi *
                      </label>
                      <input
                        type="text"
                        value={salesData.checkInDate}
                        className="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-gray-100 dark:bg-gray-600 text-gray-900 dark:text-white transition-colors duration-200"
                        readOnly
                      />
                    </div>
                    <div>
                      <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2 transition-colors duration-200">
                        Çıkış Tarihi *
                      </label>
                      <input
                        type="text"
                        value={salesData.checkOutDate}
                        className="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-gray-100 dark:bg-gray-600 text-gray-900 dark:text-white transition-colors duration-200"
                        readOnly
                      />
                    </div>
                    <div>
                      <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2 transition-colors duration-200">
                        Satış Toplam Tutarı
                      </label>
                      <input
                        type="text"
                        value={`TRY: ${formatAmount(getTotalForCurrency('TRY'))}, EUR: ${formatAmount(getTotalForCurrency('EUR'))}, USD: ${formatAmount(getTotalForCurrency('USD'))}, GBP: ${formatAmount(getTotalForCurrency('GBP'))}`}
                        className="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-gray-100 dark:bg-gray-600 text-gray-900 dark:text-white transition-colors duration-200"
                        readOnly
                      />
                    </div>
                    <div>
                      <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2 transition-colors duration-200">
                        Durum
                      </label>
                      <input
                        type="text"
                        value={salesData.status}
                        className="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-gray-100 dark:bg-gray-600 text-gray-900 dark:text-white transition-colors duration-200"
                        readOnly
                      />
                    </div>
                  </div>
                </div>

                {/* Accommodation Section - Maliyet Yönetimi */}
                {showAccommodation && (
                  <div className="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-700 rounded-lg p-6 mb-6 transition-colors duration-200">
                    <div className="flex justify-between items-center mb-4">
                      <h3 className="text-lg font-medium text-red-900 dark:text-red-100 transition-colors duration-200">Konaklama Maliyetleri</h3>
                      <div className="text-sm text-red-600 dark:text-red-300 transition-colors duration-200">
                        Satış verilerinden çekilen odalar - Maliyetleri düzenleyebilirsiniz
                      </div>
                    </div>
                    
                    {rooms.map((room, index) => (
                      <div key={room.id} className="border border-red-300 dark:border-red-600 rounded-lg p-4 mb-4 bg-white dark:bg-gray-700 transition-colors duration-200">
                        <div className="flex justify-between items-center mb-3">
                          <h4 className="font-medium text-red-800 dark:text-red-200 transition-colors duration-200">Oda {index + 1}</h4>
                        </div>
                        <div className="grid grid-cols-1 md:grid-cols-10 gap-3">
                          <div>
                            <label className="block text-xs font-medium text-red-700 dark:text-red-300 mb-1 transition-colors duration-200">Otel</label>
                            <input
                              type="text"
                              value={hotels.find(h => h.id === room.hotelId)?.name || room.hotelId}
                              className="w-full px-2 py-1 text-sm border border-red-300 dark:border-red-600 rounded-md bg-gray-100 dark:bg-gray-600 text-gray-900 dark:text-white transition-colors duration-200"
                              readOnly
                            />
                          </div>
                          <div>
                            <label className="block text-xs font-medium text-red-700 dark:text-red-300 mb-1 transition-colors duration-200">Oda Tipi</label>
                            <input
                              type="text"
                              value={room.roomType}
                              className="w-full px-2 py-1 text-sm border border-red-300 dark:border-red-600 rounded-md bg-gray-100 dark:bg-gray-600 text-gray-900 dark:text-white transition-colors duration-200"
                              readOnly
                            />
                          </div>
                          <div>
                            <label className="block text-xs font-medium text-red-700 dark:text-red-300 mb-1 transition-colors duration-200">Misafir</label>
                            <input
                              type="text"
                              value={room.guestInfo}
                              className="w-full px-2 py-1 text-sm border border-red-300 dark:border-red-600 rounded-md bg-gray-100 dark:bg-gray-600 text-gray-900 dark:text-white transition-colors duration-200"
                              readOnly
                            />
                          </div>
                          <div>
                            <label className="block text-xs font-medium text-red-700 dark:text-red-300 mb-1 transition-colors duration-200">Satış Fiyatı</label>
                            <input
                              type="text"
                              value={room.price ? formatAmount(room.price) : ''}
                              className="w-full px-2 py-1 text-sm border border-red-300 dark:border-red-600 rounded-md bg-gray-100 dark:bg-gray-600 text-gray-900 dark:text-white transition-colors duration-200"
                              readOnly
                            />
                          </div>
                          <div>
                            <label className="block text-xs font-medium text-red-700 dark:text-red-300 mb-1 transition-colors duration-200">Satış Dövizi</label>
                            <input
                              type="text"
                              value={room.currency}
                              className="w-full px-2 py-1 text-sm border border-red-300 dark:border-red-600 rounded-md bg-gray-100 dark:bg-gray-600 text-gray-900 dark:text-white transition-colors duration-200"
