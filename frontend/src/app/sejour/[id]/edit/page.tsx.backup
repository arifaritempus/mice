                            }
                          </div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>

                {/* Summary */}
                <div className="bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-lg p-4 transition-colors duration-200">
                  <h3 className="text-lg font-medium text-gray-900 dark:text-white mb-4 transition-colors duration-200">Maliyet ve Kar/Zarar Özeti</h3>
                  <div className="grid grid-cols-1 md:grid-cols-4 gap-6">
                    <div className="bg-red-50 dark:bg-red-900/20 p-4 rounded-lg transition-colors duration-200">
                      <h4 className="text-sm font-medium text-red-900 dark:text-red-100 transition-colors duration-200">Toplam Maliyetler</h4>
                      <div className="space-y-1">
                        <p className="text-lg font-bold text-red-600 dark:text-red-100 transition-colors duration-200">TRY: {formatAmount(getCostForCurrency('TRY'))}</p>
                        <p className="text-lg font-bold text-red-600 dark:text-red-100 transition-colors duration-200">EUR: {formatAmount(getCostForCurrency('EUR'))}</p>
                        <p className="text-lg font-bold text-red-600 dark:text-red-100 transition-colors duration-200">USD: {formatAmount(getCostForCurrency('USD'))}</p>
                        <p className="text-lg font-bold text-red-600 dark:text-red-100 transition-colors duration-200">GBP: {formatAmount(getCostForCurrency('GBP'))}</p>
                      </div>
                    </div>
                    <div className="bg-blue-50 dark:bg-blue-900/20 p-4 rounded-lg transition-colors duration-200">
                      <h4 className="text-sm font-medium text-blue-900 dark:text-blue-100 transition-colors duration-200">Toplam Satış</h4>
                      <div className="space-y-1">
                        <p className="text-lg font-bold text-blue-600 dark:text-blue-100 transition-colors duration-200">TRY: {formatAmount(getTotalForCurrency('TRY'))}</p>
                        <p className="text-lg font-bold text-blue-600 dark:text-blue-100 transition-colors duration-200">EUR: {formatAmount(getTotalForCurrency('EUR'))}</p>
                        <p className="text-lg font-bold text-blue-600 dark:text-blue-100 transition-colors duration-200">USD: {formatAmount(getTotalForCurrency('USD'))}</p>
                        <p className="text-lg font-bold text-blue-600 dark:text-blue-100 transition-colors duration-200">GBP: {formatAmount(getTotalForCurrency('GBP'))}</p>
                      </div>
                    </div>
                    <div className="bg-green-50 dark:bg-green-900/20 p-4 rounded-lg transition-colors duration-200">
                      <h4 className="text-sm font-medium text-green-900 dark:text-green-100 transition-colors duration-200">Kar/Zarar</h4>
                      <div className="space-y-1">
                        <p className={`text-lg font-bold ${getProfitForCurrency('TRY') >= 0 ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400'} transition-colors duration-200`}>
                          TRY: {formatAmount(getProfitForCurrency('TRY'))}
                        </p>
                        <p className={`text-lg font-bold ${getProfitForCurrency('EUR') >= 0 ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400'} transition-colors duration-200`}>
                          EUR: {formatAmount(getProfitForCurrency('EUR'))}
                        </p>
                        <p className={`text-lg font-bold ${getProfitForCurrency('USD') >= 0 ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400'} transition-colors duration-200`}>
                          USD: {formatAmount(getProfitForCurrency('USD'))}
                        </p>
                        <p className={`text-lg font-bold ${getProfitForCurrency('GBP') >= 0 ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400'} transition-colors duration-200`}>
                          GBP: {formatAmount(getProfitForCurrency('GBP'))}
                        </p>
                      </div>
                    </div>
                    <div className="bg-purple-50 dark:bg-purple-900/20 p-4 rounded-lg transition-colors duration-200">
                      <h4 className="text-sm font-medium text-purple-900 dark:text-purple-100 transition-colors duration-200">Kar Marjı</h4>
                      <div className="space-y-1">
                        <p className="text-lg font-bold text-purple-600 dark:text-purple-100 transition-colors duration-200">
                          TRY: {getCostForCurrency('TRY') > 0 ? ((getProfitForCurrency('TRY') / getCostForCurrency('TRY')) * 100).toFixed(1) : 0}%
                        </p>
                        <p className="text-lg font-bold text-purple-600 dark:text-purple-100 transition-colors duration-200">
                          EUR: {getCostForCurrency('EUR') > 0 ? ((getProfitForCurrency('EUR') / getCostForCurrency('EUR')) * 100).toFixed(1) : 0}%
                        </p>
                        <p className="text-lg font-bold text-purple-600 dark:text-purple-100 transition-colors duration-200">
                          USD: {getCostForCurrency('USD') > 0 ? ((getProfitForCurrency('USD') / getCostForCurrency('USD')) * 100).toFixed(1) : 0}%
                        </p>
                        <p className="text-lg font-bold text-purple-600 dark:text-purple-100 transition-colors duration-200">
                          GBP: {getCostForCurrency('GBP') > 0 ? ((getProfitForCurrency('GBP') / getCostForCurrency('GBP')) * 100).toFixed(1) : 0}%
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            )}

            {/* Collections Tab */}
            {activeTab === 'collections' && (
              <div className="space-y-6">
                <h2 className="text-xl font-semibold text-gray-900 dark:text-white mb-6 transition-colors duration-200">Tahsilat Yönetimi</h2>
                
                <div className="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-700 rounded-lg p-4 mb-6 transition-colors duration-200">
                  <h3 className="text-lg font-medium text-yellow-900 dark:text-yellow-100 mb-2 transition-colors duration-200">Tahsilat Bilgileri</h3>
                  <div>
                    <label className="block text-sm font-medium text-yellow-700 dark:text-yellow-300 mb-1 transition-colors duration-200">Toplam Satış Tutarı</label>
                    <input
                      type="text"
                      value={`TRY: ${formatAmount(getTotalForCurrency('TRY'))}, EUR: ${formatAmount(getTotalForCurrency('EUR'))}, USD: ${formatAmount(getTotalForCurrency('USD'))}, GBP: ${formatAmount(getTotalForCurrency('GBP'))}`}
                      className="w-full px-3 py-2 border border-yellow-300 dark:border-yellow-600 rounded-md bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-white transition-colors duration-200"
                      readOnly
                    />
                  </div>
                </div>

                <div className="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-700 rounded-lg p-4 transition-colors duration-200">
                  <h3 className="text-lg font-medium text-green-900 dark:text-green-100 mb-2 transition-colors duration-200">Tahsilat Kayıtları</h3>
                  
                  {/* Mevcut Tahsilatlar */}
                  {collections.filter(collection => collection.amount > 0 || collection.type || collection.description).map((collection, index) => (
                    <div key={collection.id} className="border border-green-300 dark:border-green-600 rounded-lg p-4 mb-3 bg-white dark:bg-gray-700 transition-colors duration-200">
                      <div className="flex justify-between items-center mb-3">
                        <h4 className="font-medium text-green-800 dark:text-green-200 transition-colors duration-200">Tahsilat {index + 1}</h4>
                        <button
                          type="button"
                          onClick={() => removeCollection(collection.id)}
                          className="text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300 transition-colors duration-200"
                        >
                          ✕
                        </button>
                      </div>
                      <div className="grid grid-cols-1 md:grid-cols-5 gap-3">
                        <div>
                          <label className="block text-xs font-medium text-green-700 dark:text-green-300 mb-1 transition-colors duration-200">Tahsilat Tipi</label>
                          <select
                            value={collection.type}
                            onChange={(e) => updateCollection(collection.id, 'type', e.target.value)}
                            className="w-full px-2 py-1 text-sm border border-green-300 dark:border-green-600 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white transition-colors duration-200"
                          >
                            <option value="">Tahsilat Tipi</option>
                            <option value="cash">Nakit</option>
                            <option value="bank">Havale</option>
                            <option value="card">Kredi Kartı</option>
                            <option value="cheque">Çek/Senet</option>
                          </select>
                        </div>
                        <div>
                          <label className="block text-xs font-medium text-green-700 dark:text-green-300 mb-1 transition-colors duration-200">Tutar</label>
                          <div className="flex gap-2">
                            <input
                              type="text"
                              inputMode="decimal"
                              value={servicePriceInput[`collection_${collection.id}`] ?? (collection.amount ? formatAmount(collection.amount) : '')}
                              onChange={(e) => setServicePriceInput(prev => ({...prev, [`collection_${collection.id}`]: normalizeTyping(e.target.value)}))}
                              onBlur={(e) => {
                                const parsed = parseTrAmount(servicePriceInput[`collection_${collection.id}`] ?? e.target.value);
                                if (parsed !== null) {
                                  updateCollection(collection.id, 'amount', parsed);
                                  setServicePriceInput(prev => ({...prev, [`collection_${collection.id}`]: formatAmount(parsed)}));
                                }
                              }}
                              className="flex-1 px-2 py-1 text-sm border border-green-300 dark:border-green-600 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 transition-colors duration-200"
                              placeholder="Tutar"
                            />
                            <select
                              value={collection.currency}
                              onChange={(e) => updateCollection(collection.id, 'currency', e.target.value)}
                              className="w-20 px-2 py-1 text-sm border border-green-300 dark:border-green-600 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white transition-colors duration-200"
                            >
                              <option value="TRY">TRY</option>
                              <option value="EUR">EUR</option>
                              <option value="USD">USD</option>
                              <option value="GBP">GBP</option>
                            </select>
                          </div>
                        </div>
                        <div>
                          <label className="block text-xs font-medium text-green-700 dark:text-green-300 mb-1 transition-colors duration-200">Tarih</label>
                          <input
                            type="date"
                            value={collection.date}
                            onChange={(e) => updateCollection(collection.id, 'date', e.target.value)}
                            className="w-full px-2 py-1 text-sm border border-green-300 dark:border-green-600 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white transition-colors duration-200"
                          />
                        </div>
                        <div>
                          <label className="block text-xs font-medium text-green-700 dark:text-green-300 mb-1 transition-colors duration-200">Açıklama</label>
                          <input
                            type="text"
                            value={collection.description}
                            onChange={(e) => updateCollection(collection.id, 'description', e.target.value)}
                            className="w-full px-2 py-1 text-sm border border-green-300 dark:border-green-600 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-400 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 transition-colors duration-200"
                            placeholder="Açıklama"
                          />
                        </div>
                      </div>
                    </div>
                  ))}
                  
                  {/* Yeni Tahsilat Ekleme Butonu */}
                  <button
                    type="button"
                    onClick={addCollection}
                    className="px-4 py-2 bg-green-600 dark:bg-green-500 text-white rounded-md hover:bg-green-700 dark:hover:bg-green-600 transition-colors duration-200"
                  >
                    + Tahsilat Ekle
                  </button>
                </div>

                <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                  <div className="bg-blue-50 dark:bg-blue-900/20 p-4 rounded-lg transition-colors duration-200">
                    <h3 className="text-sm font-medium text-blue-900 dark:text-blue-100 transition-colors duration-200">Toplam Tutarlar</h3>
                    <div className="space-y-1">
                      <p className="text-lg font-bold text-blue-600 dark:text-blue-400 transition-colors duration-200">TRY: {formatAmount(getTotalForCurrency('TRY'))}</p>
                      <p className="text-lg font-bold text-blue-600 dark:text-blue-400 transition-colors duration-200">EUR: {formatAmount(getTotalForCurrency('EUR'))}</p>
                      <p className="text-lg font-bold text-blue-600 dark:text-blue-400 transition-colors duration-200">USD: {formatAmount(getTotalForCurrency('USD'))}</p>
                      <p className="text-lg font-bold text-blue-600 dark:text-blue-400 transition-colors duration-200">GBP: {formatAmount(getTotalForCurrency('GBP'))}</p>
                    </div>
                  </div>
                  <div className="bg-green-50 dark:bg-green-900/20 p-4 rounded-lg transition-colors duration-200">
                    <h3 className="text-sm font-medium text-green-900 dark:text-green-100 transition-colors duration-200">Toplam Tahsilat</h3>
                    <div className="space-y-1">
                      <p className="text-lg font-bold text-green-600 dark:text-green-400 transition-colors duration-200">TRY: {formatAmount(calculateTotalCollectionsByCurrency('TRY'))}</p>
                      <p className="text-lg font-bold text-green-600 dark:text-green-400 transition-colors duration-200">EUR: {formatAmount(calculateTotalCollectionsByCurrency('EUR'))}</p>
                      <p className="text-lg font-bold text-green-600 dark:text-green-400 transition-colors duration-200">USD: {formatAmount(calculateTotalCollectionsByCurrency('USD'))}</p>
                      <p className="text-lg font-bold text-green-600 dark:text-green-400 transition-colors duration-200">GBP: {formatAmount(calculateTotalCollectionsByCurrency('GBP'))}</p>
                    </div>
                  </div>
                  <div className="bg-red-50 dark:bg-red-900/20 p-4 rounded-lg transition-colors duration-200">
                    <h3 className="text-sm font-medium text-red-900 dark:text-red-100 transition-colors duration-200">Kalan Bakiye</h3>
                    <div className="space-y-1">
                      <p className={`text-lg font-bold ${calculateBalanceByCurrency('TRY') >= 0 ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400'} transition-colors duration-200`}>
                        TRY: {formatAmount(calculateBalanceByCurrency('TRY'))}
                      </p>
                      <p className={`text-lg font-bold ${calculateBalanceByCurrency('EUR') >= 0 ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400'} transition-colors duration-200`}>
                        EUR: {formatAmount(calculateBalanceByCurrency('EUR'))}
                      </p>
                      <p className={`text-lg font-bold ${calculateBalanceByCurrency('USD') >= 0 ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400'} transition-colors duration-200`}>
                        USD: {formatAmount(calculateBalanceByCurrency('USD'))}
                      </p>
                      <p className={`text-lg font-bold ${calculateBalanceByCurrency('GBP') >= 0 ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400'} transition-colors duration-200`}>
                        GBP: {formatAmount(calculateBalanceByCurrency('GBP'))}
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            )}

            {/* Sales Invoices Tab */}



          </div>
        </div>

        {/* Submit Buttons */}
        <form onSubmit={handleSubmit}>
          <div className="flex justify-end space-x-4">
            <button
              type="button"
              onClick={() => router.push('/sejour')}
              className="px-6 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-md hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors duration-200"
            >
              İptal
            </button>
            <button
              type="submit"
              disabled={loading}
              className="px-6 py-2 bg-blue-600 dark:bg-blue-500 text-white rounded-md hover:bg-blue-700 dark:hover:bg-blue-600 transition-colors duration-200 disabled:opacity-50 disabled:cursor-not-allowed"
            >
              {loading ? 'Güncelleniyor...' : 'Sejour Güncelle'}
            </button>
          </div>
        </form>
    </div>
  );
} 