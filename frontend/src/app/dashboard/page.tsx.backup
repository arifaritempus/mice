'use client'

import { useState, useEffect, useCallback } from 'react'
import Link from 'next/link'
import { formatDate } from '@/utils/formatters'
import LoadingSpinner from '@/components/LoadingSpinner'
import { usePermissions, Module } from '@/lib/permissions'

interface Project {
  id: string
  name: string
  status: string
  start_date: string
  end_date: string
  client_name: string
  budget: number
  revenue: number
}

interface Sejour {
  id: string
  name: string
  hotel_name: string
  start_date: string
  end_date: string
  guest_count: number
  total_cost: number
  status: string
}

interface Transfer {
  id: string
  type: string
  pickup_location: string
  dropoff_location: string
  date: string
  guest_count: number
  cost: number
  status: string
}

interface Ticket {
  id: string
  flight_number: string
  departure: string
  arrival: string
  date: string
  passenger_count: number
  cost: number
  status: string
}

interface Guide {
  id: string
  name: string
  service_date: string
  location: string
  guest_count: number
  cost: number
  status: string
}

interface PartTime {
  id: string
  name: string
  service_date: string
  location: string
  hours: number
  hourly_rate: number
  status: string
}

interface UserLog {
  id: string
  user_name: string
  action: string
  module: string
  timestamp: string
  ip_address: string
  details: string
}

interface FinancialSummary {
  total_revenue: number
  total_expenses: number
  profit_margin: number
  monthly_growth: number
}

export default function DashboardPage() {
  const { canView, canCreate, canEdit, canDelete, userRole, loading: permissionsLoading } = usePermissions()
  const [lastUpdate, setLastUpdate] = useState<Date>(new Date())
  const [projects, setProjects] = useState<Project[]>([])
  const [sejours, setSejours] = useState<Sejour[]>([])
  const [transfers, setTransfers] = useState<Transfer[]>([])
  const [tickets, setTickets] = useState<Ticket[]>([])
  const [guides, setGuides] = useState<Guide[]>([])
  const [partTimes, setPartTimes] = useState<PartTime[]>([])
  const [userLogs, setUserLogs] = useState<UserLog[]>([])
  const [financialSummary, setFinancialSummary] = useState<FinancialSummary>({
    total_revenue: 0,
    total_expenses: 0,
    profit_margin: 0,
    monthly_growth: 0
  })
  const [loading, setLoading] = useState(true)
  const [selectedPeriod, setSelectedPeriod] = useState('month')
  const [dateRange, setDateRange] = useState({
    startDate: '',
    endDate: ''
  })
  const [statusFilter, setStatusFilter] = useState('all')
  const [categoryFilter, setCategoryFilter] = useState('all')
  const [searchTerm, setSearchTerm] = useState('')

  // Filtreleme fonksiyonları
  const filterByDateRange = useCallback((items: any[], dateField: string) => {
    if (!dateRange.startDate && !dateRange.endDate) return items
    
    return items.filter(item => {
      const itemDate = new Date(item[dateField])
      const startDate = dateRange.startDate ? new Date(dateRange.startDate) : null
      const endDate = dateRange.endDate ? new Date(dateRange.endDate) : null
      
      if (startDate && itemDate < startDate) return false
      if (endDate && itemDate > endDate) return false
      return true
    })
  }, [dateRange])

  const filterByStatus = useCallback((items: any[]) => {
    if (statusFilter === 'all') return items
    return items.filter(item => item.status?.toLowerCase() === statusFilter.toLowerCase())
  }, [statusFilter])

  // loadFallbackData fonksiyonu
  const loadFallbackData = useCallback(async () => {
    // Gerçek veri yoksa örnek veriler
    const projectsData: Project[] = [
      {
        id: '1',
        name: 'Tech Conference 2025',
        status: 'active',
        start_date: '2025-09-15',
        end_date: '2025-09-18',
        client_name: 'TechCorp',
        budget: 50000,
        revenue: 75000
      },
      {
        id: '2',
        name: 'Medical Summit',
        status: 'active',
        start_date: '2025-10-20',
        end_date: '2025-10-22',
        client_name: 'MedGroup',
        budget: 35000,
        revenue: 45000
      }
    ]
    setProjects(projectsData)

    const sejoursData: Sejour[] = [
      {
        id: '1',
        name: 'Luxury Resort Package',
        hotel_name: 'Concorde Luxury Resort',
        start_date: '2025-09-10',
        end_date: '2025-09-15',
        guest_count: 45,
        total_cost: 22500,
        status: 'confirmed'
      },
      {
        id: '2',
        name: 'Business Conference Stay',
        hotel_name: 'Grand Hotel Istanbul',
        start_date: '2025-10-15',
        end_date: '2025-10-18',
        guest_count: 28,
        total_cost: 16800,
        status: 'pending'
      }
    ]
    setSejours(sejoursData)

    const transfersData: Transfer[] = [
      {
        id: '1',
        type: 'Airport Transfer',
        pickup_location: 'Antalya Airport',
        dropoff_location: 'Concorde Resort',
        date: '2025-09-10',
        guest_count: 45,
        cost: 4500,
        status: 'confirmed'
      },
      {
        id: '2',
        type: 'City Tour Transfer',
        pickup_location: 'Grand Hotel',
        dropoff_location: 'Historical Sites',
        date: '2025-10-16',
        guest_count: 28,
        cost: 2800,
        status: 'pending'
      }
    ]
    setTransfers(transfersData)

    const ticketsData: Ticket[] = [
      {
        id: '1',
        flight_number: 'TK1234',
        departure: 'Istanbul',
        arrival: 'Antalya',
        date: '2025-09-10',
        passenger_count: 45,
        cost: 13500,
        status: 'confirmed'
      },
      {
        id: '2',
        flight_number: 'TK5678',
        departure: 'Ankara',
        arrival: 'Istanbul',
        date: '2025-10-15',
        passenger_count: 28,
        cost: 8400,
        status: 'pending'
      }
    ]
    setTickets(ticketsData)

    const guidesData: Guide[] = [
      {
        id: '1',
        name: 'Ahmet Yılmaz',
        service_date: '2025-09-12',
        location: 'Antalya',
        guest_count: 45,
        cost: 2250,
        status: 'confirmed'
      },
      {
        id: '2',
        name: 'Fatma Demir',
        service_date: '2025-10-17',
        location: 'Istanbul',
        guest_count: 28,
        cost: 1400,
        status: 'pending'
      }
    ]
    setGuides(guidesData)

    const partTimesData: PartTime[] = [
      {
        id: '1',
        name: 'Mehmet Kaya',
        service_date: '2025-09-11',
        location: 'Antalya',
        hours: 8,
        hourly_rate: 50,
        status: 'confirmed'
      },
      {
        id: '2',
        name: 'Ayşe Özkan',
        service_date: '2025-10-16',
        location: 'Istanbul',
        hours: 6,
        hourly_rate: 45,
        status: 'pending'
      }
    ]
    setPartTimes(partTimesData)

    const userLogsData: UserLog[] = [
      {
        id: '1',
        user_name: 'admin@eventiq.com',
        action: 'LOGIN',
        module: 'Authentication',
        timestamp: new Date().toISOString(),
        ip_address: '192.168.1.100',
        details: 'Başarılı giriş'
      },
      {
        id: '2',
        user_name: 'manager@eventiq.com',
        action: 'CREATE',
        module: 'Projects',
        timestamp: new Date(Date.now() - 300000).toISOString(),
        ip_address: '192.168.1.101',
        details: 'Yeni proje oluşturuldu: Tech Conference 2025'
      },
      {
        id: '3',
        user_name: 'operator@eventiq.com',
        action: 'UPDATE',
        module: 'Sejour',
        timestamp: new Date(Date.now() - 600000).toISOString(),
        ip_address: '192.168.1.102',
        details: 'Sejour rezervasyonu güncellendi: Luxury Resort Package'
      }
    ]
    setUserLogs(userLogsData)

    // Finansal özet hesaplama - filtreleme uygulanmış verilerle
    const filteredProjects = filterByDateRange(filterByStatus(projectsData), 'start_date')
    const filteredSejours = filterByDateRange(filterByStatus(sejoursData), 'start_date')
    const filteredTransfers = filterByDateRange(filterByStatus(transfersData), 'date')
    const filteredTickets = filterByDateRange(filterByStatus(ticketsData), 'date')
    const filteredGuides = filterByDateRange(filterByStatus(guidesData), 'service_date')
    const filteredPartTimes = filterByDateRange(filterByStatus(partTimesData), 'service_date')
    
    const totalRevenue = filteredProjects.reduce((sum, p) => sum + p.revenue, 0)
    const totalExpenses = filteredSejours.reduce((sum, s) => sum + s.total_cost, 0) +
                         filteredTransfers.reduce((sum, t) => sum + t.cost, 0) +
                         filteredTickets.reduce((sum, t) => sum + t.cost, 0) +
                         filteredGuides.reduce((sum, g) => sum + g.cost, 0) +
                         filteredPartTimes.reduce((sum, pt) => sum + (pt.hours * pt.hourly_rate), 0)
    
    setFinancialSummary({
      total_revenue: totalRevenue,
      total_expenses: totalExpenses,
      profit_margin: totalRevenue > 0 ? ((totalRevenue - totalExpenses) / totalRevenue) * 100 : 0,
      monthly_growth: 12.5 // Örnek büyüme oranı
    })
  }, [filterByDateRange, filterByStatus])

  // Gerçek verileri çek - TÜM HOOK'LAR ERKEN RETURN'LERDEN ÖNCE OLMALI
  useEffect(() => {
    const fetchData = async () => {
      try {
        setLoading(true)
        
        // API'den veri çekme simülasyonu
        const response = await fetch('/api/dashboard/data', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ 
            period: selectedPeriod,
            dateRange,
            statusFilter,
            categoryFilter,
            searchTerm
          })
        })

        if (response.ok) {
          const data = await response.json()
          setProjects(data.projects || [])
          setSejours(data.sejours || [])
          setTransfers(data.transfers || [])
          setTickets(data.tickets || [])
          setGuides(data.guides || [])
          setPartTimes(data.partTimes || [])
          setUserLogs(data.userLogs || [])
          setFinancialSummary(data.financialSummary || {
            total_revenue: 0,
            total_expenses: 0,
            profit_margin: 0,
            monthly_growth: 0
          })
        } else {
          // Fallback veriler
          await loadFallbackData()
        }
      } catch (error) {
        console.error('API veri çekme hatası:', error)
        await loadFallbackData()
      } finally {
        setLoading(false)
      }
    }

    fetchData()
  }, [selectedPeriod, dateRange, statusFilter, categoryFilter, searchTerm, loadFallbackData])

  // Yetkiler yüklenirken bekle - ERKEN RETURN (HOOK'LARDAN SONRA)
  if (permissionsLoading) {
    return (
      <div className="min-h-screen bg-gray-50 dark:bg-gray-950 flex items-center justify-center transition-colors duration-200">
        <div className="text-center">
          <div className="relative mx-auto mb-3">
            <div className="w-8 h-8 rounded-full border-4 border-gray-200 dark:border-gray-700"></div>
            <div className="absolute top-0 left-0 w-8 h-8 rounded-full border-4 border-transparent border-t-blue-600 dark:border-t-blue-400 animate-spin"></div>
            <div className="absolute top-0 left-0 w-8 h-8 rounded-full border-4 border-transparent border-r-blue-500 dark:border-r-blue-300 animate-spin" style={{animationDelay: '0.1s', animationDuration: '1.5s'}}></div>
          </div>
          <h2 className="text-lg font-semibold text-gray-900 dark:text-white mb-1 transition-colors duration-200">Yükleniyor...</h2>
          <p className="text-xs text-gray-600 dark:text-gray-400 transition-colors duration-200">Yetkiler kontrol ediliyor</p>
        </div>
      </div>
    );
  }

  // Dashboard görüntüleme yetkisi kontrolü - ERKEN RETURN (HOOK'LARDAN SONRA)
  if (!canView(Module.DASHBOARD)) {
    return (
      <div className="min-h-screen bg-gray-50 dark:bg-gray-950 flex items-center justify-center transition-colors duration-200">
        <div className="text-center">
          <h1 className="text-2xl font-bold text-gray-900 dark:text-white mb-4">Yetki Gerekli</h1>
          <p className="text-gray-600 dark:text-gray-400 mb-6">Dashboard sayfasına erişim için yetkiniz bulunmuyor.</p>
          <Link href="/" className="bg-blue-600 dark:bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-700 dark:hover:bg-blue-600 transition-colors duration-200">
            Ana Sayfaya Dön
          </Link>
        </div>
      </div>
    );
  }

  // Filtreleme fonksiyonları (normal fonksiyonlar, hook değil)
  const filterBySearch = (items: any[], searchFields: string[]) => {
    if (!searchTerm) return items
    
    const lowerSearchTerm = searchTerm.toLowerCase()
    return items.filter(item => 
      searchFields.some(field => 
        item[field]?.toString().toLowerCase().includes(lowerSearchTerm)
      )
    )
  }

  const getUpcomingItems = (items: any[], dateField: string, limit: number = 3): any[] => {
    try {
      const now = new Date()
      let filteredItems = items
      
      // Tarih aralığı filtresi
      if (dateRange.startDate || dateRange.endDate) {
        filteredItems = filterByDateRange(filteredItems, dateField)
      }
      
      // Durum filtresi
      filteredItems = filterByStatus(filteredItems)
      
      // Gelecekteki öğeleri filtrele ve sırala
      return filteredItems
        .filter(item => {
          const itemDate = new Date(item[dateField])
          return itemDate >= now
        })
        .sort((a, b) => {
          const dateA = new Date(a[dateField]).getTime()
          const dateB = new Date(b[dateField]).getTime()
          return dateA - dateB
        })
        .slice(0, limit)
    } catch (error) {
      console.error('getUpcomingItems hatası:', error)
      return []
    }
  }

  // Filtrelenmiş veriler
  const filteredProjects = filterBySearch(
    filterByDateRange(filterByStatus(projects), 'start_date'),
    ['name', 'client_name']
  )
  const filteredSejours = filterBySearch(
    filterByDateRange(filterByStatus(sejours), 'start_date'),
    ['name', 'hotel_name']
  )
  const filteredTransfers = filterBySearch(
    filterByDateRange(filterByStatus(transfers), 'date'),
    ['type', 'pickup_location', 'dropoff_location']
  )
  const filteredTickets = filterBySearch(
    filterByDateRange(filterByStatus(tickets), 'date'),
    ['flight_number', 'departure', 'arrival']
  )
  const filteredGuides = filterBySearch(
    filterByDateRange(filterByStatus(guides), 'service_date'),
    ['name', 'location']
  )
  const filteredPartTimes = filterBySearch(
    filterByDateRange(filterByStatus(partTimes), 'service_date'),
    ['name', 'location']
  )

  // Yaklaşan öğeler
  const upcomingProjects = getUpcomingItems(projects, 'start_date', 5)
  const upcomingSejours = getUpcomingItems(sejours, 'start_date', 5)
  const upcomingTransfers = getUpcomingItems(transfers, 'date', 5)
  const upcomingTickets = getUpcomingItems(tickets, 'date', 5)
  const upcomingGuides = getUpcomingItems(guides, 'service_date', 5)
  const upcomingPartTimes = getUpcomingItems(partTimes, 'service_date', 5)

  return (
    <div className="min-h-screen bg-gray-50 dark:bg-gray-950 transition-colors duration-200">
      {/* ... rest of the component JSX ... */}
      <div className="container mx-auto px-4 py-8">
        <h1 className="text-3xl font-bold text-gray-900 dark:text-white mb-6">Dashboard</h1>
        {/* Dashboard içeriği buraya eklenecek */}
      </div>
    </div>
  )
}
