        console.log('🔍 Debug - OTEL ile başlayan parent_id\'ler:', categories.filter(cat => cat.parent_id && cat.parent_id.includes('OTEL')));
        console.log('🔍 Debug - Tüm parent_id değerleri:', [...new Set(categories.map(cat => cat.parent_id).filter(Boolean))]);
        
