      biletlemeTarihi: today, // Bugünün tarihi ile başla
      tedarikci: '',
      havayolu: '',
      pnr: '',
      ucusTipi: '',
      gidisTarihi: '',
      gidisSaati: '',
      gidisUcusKodu: '',
      donusTarihi: '',
      donusSaati: '',
      donusUcusKodu: '',
      guzergah: '',
      kisiSayisi: 1,
      ppMaliyet: 0,
      toplamMaliyet: 0,
      doviz: 'EUR',
      kur: 1.0000,
      toplamTl: 0,
      misafirler: '',
      durum: 'aktif'
    };
    setEditingFlightIndex(flightTickets.length);
    setTempFlightItem(newItem);
