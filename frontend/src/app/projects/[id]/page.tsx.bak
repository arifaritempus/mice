  // İnsan Kaynakları alt kategorilerini yükle
  useEffect(() => {
    const loadHrSubCategories = async () => {
      try {
        const categories = await categoriesService.getAll();
        console.log('🔍 Tüm kategoriler yüklendi:', categories.length, 'adet');
        console.log('🔍 Kategori örnekleri:', categories.slice(0, 3));
        console.log('🔍 Kategori alanları:', categories.length > 0 ? Object.keys(categories[0]) : 'Kategori yok');
        
        // Ana kategorileri listele
        const mainCategories = categories.filter(cat => cat.parent_id === null);
        console.log('🔍 Ana kategoriler:', mainCategories.length, 'adet');
        console.log('🔍 Ana kategori detayları:', mainCategories.map(c => ({ id: c.id, name: c.name, code: c.code })));
        
        // İnsan Kaynakları ana kategorisini bul - önce code ile ara, sonra isim ile
        console.log('🔍 İnsan Kaynakları ana kategorisi aranıyor...');
        let hrMainCategory = categories.find(cat => {
          if (cat.parent_id !== null) return false;
          // Önce code alanı ile ara
          if (cat.code === 'CAT_006') return true;
          // Sonra isim ile ara
          const name = cat.name.toUpperCase();
          return name.includes('İNSAN KAYNAKLARI') || 
                 name.includes('İNSAN KAYNAK') || 
                 name.includes('HUMAN RESOURCES') ||
                 name.includes('HR');
        });
        console.log('🔍 İnsan Kaynakları ana kategori sonucu:', hrMainCategory);
        
        if (hrMainCategory) {
          console.log('🔍 Ana kategori bulundu, alt kategoriler aranıyor...');
          console.log('🔍 Ana kategori ID:', hrMainCategory.id);
          console.log('🔍 Ana kategori adı:', hrMainCategory.name);
          
          // Bu ana kategorinin alt kategorilerini bul - isim ile
          const hrSubCategories = categories.filter(cat => {
            // Alt kategorilerin parent_id'si ana kategorinin ID'si olmalı
            return cat.parent_id === hrMainCategory.id;
          });
          console.log('🔍 İnsan Kaynakları alt kategoriler:', hrSubCategories.length, 'adet');
          console.log('🔍 Alt kategori detayları:', hrSubCategories.map(cat => ({ id: cat.id, name: cat.name, parent_id: cat.parent_id })));
          setHrSubCategories(hrSubCategories);
        } else {
          console.log('❌ İnsan Kaynakları ana kategorisi bulunamadı');
          console.log('❌ Mevcut ana kategoriler:', mainCategories.map(c => ({ id: c.id, name: c.name })));
          setHrSubCategories([]);
        }
      } catch (error) {
        console.error('İnsan Kaynakları alt kategoriler yüklenirken hata:', error);
        setHrSubCategories([]);
      }
    };
    loadHrSubCategories();
  }, []);

