    setTempFinancialServiceItem({ ...item });
    setEditingFinancialServiceIndex(index);
    setFinancialAmountInput(formatNumberForDisplay(item.amount || 0));
    setFinancialTotalTRYInput(formatNumberForDisplay(item.totalTRY || 0));
