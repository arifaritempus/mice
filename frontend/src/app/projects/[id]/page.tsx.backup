    setEditingOtherServiceIndex(index);
    setOtherServiceAmountInput(formatNumberForDisplay(item.amount || 0));
    setOtherServiceTotalTRYInput(formatNumberForDisplay(item.totalTRY || 0));
  };

  const handleOtherServiceSave = () => {
