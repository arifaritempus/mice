    setFinancialServices(updated);
    localStorage.setItem(`project_financial_${projectId}`, JSON.stringify(updated));
  };

  // İnsan Kaynakları CRUD fonksiyonları
  const handleHrAdd = () => {
    console.log('handleHrAdd çağrıldı');
    const newHrItem = {
      id: Date.now() + Math.random().toString(),
      date: '',
      hotel: '',
      subCategory: '',
      subCategoryName: '',
