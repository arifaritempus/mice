// CATEGORIES
export const categoriesService = {
  async getAll(): Promise<Category[]> {
    // Load from localStorage
    const storedCategories = localStorage.getItem('categories');
    if (storedCategories) {
      return JSON.parse(storedCategories);
    }
    
    // Sabit kategori ID'leri ile default kategoriler
    const defaultCategories: Category[] = [
      // Ana Kategoriler (Sabit ID'ler)
      {
        id: 'CAT_001',
        name: 'OTEL | KONAKLAMA',
        description: 'Otel konaklama hizmetleri',
        is_active: true,
        parent_id: null,
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString()
      },
      {
        id: 'CAT_002',
        name: 'OTEL | DİĞER HİZMETLER',
        description: 'Otel diğer hizmetler',
        is_active: true,
        parent_id: null,
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString()
      },
      {
        id: 'CAT_003',
        name: 'UÇAK BİLETİ',
        description: 'Uçak bileti hizmetleri',
        is_active: true,
        parent_id: null,
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString()
      },
      {
        id: 'CAT_004',
        name: 'TRANSFER & TUR',
        description: 'Transfer ve tur hizmetleri',
        is_active: true,
        parent_id: null,
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString()
      },
      {
        id: 'CAT_005',
        name: 'ETKİNLİK',
        description: 'Etkinlik hizmetleri',
        is_active: true,
        parent_id: null,
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString()
      },
      {
        id: 'CAT_006',
        name: 'İNSAN KAYNAKLARI',
        description: 'İnsan kaynakları hizmetleri',
        is_active: true,
        parent_id: null,
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString()
      },
      {
        id: 'CAT_007',
        name: 'DİĞER OPERASYONEL HİZMETLER',
        description: 'Diğer operasyonel hizmetler',
        is_active: true,
        parent_id: null,
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString()
      },
      
      // Alt Kategoriler (Sabit ID'ler)
      {
        id: 'SUBCAT_001',
        name: 'DOUBLE ODA KİŞİ BAŞI',
        description: 'Double oda kişi başı fiyat',
        is_active: true,
        parent_id: 'CAT_001',
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString()
      },
      {
        id: 'SUBCAT_002',
        name: 'SINGLE ODA',
        description: 'Single oda fiyat',
        is_active: true,
        parent_id: 'CAT_001',
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString()
      },
      {
        id: 'SUBCAT_003',
        name: 'TOPLANTI SALONU KULLANIMI',
        description: 'Toplantı salonu kullanım ücreti',
        is_active: true,
        parent_id: 'CAT_002',
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString()
      },
      {
        id: 'SUBCAT_004',
        name: 'TEKNİK EKİPMAN KULLANIMI',
        description: 'Teknik ekipman kullanım ücreti',
        is_active: true,
        parent_id: 'CAT_002',
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString()
      },
      {
        id: 'SUBCAT_005',
        name: 'GRUP UÇAK BİLETİ',
        description: 'Grup uçak bileti',
        is_active: true,
        parent_id: 'CAT_003',
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString()
      },
      {
        id: 'SUBCAT_006',
        name: 'ALAN - OTEL - ALAN | GRUP TRANSFERİ',
        description: 'Alan-otel-alan grup transferi',
        is_active: true,
        parent_id: 'CAT_004',
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString()
      },
      {
        id: 'SUBCAT_007',
        name: 'GALA YEMEĞİ | MASA SÜSLEME',
        description: 'Gala yemeği ve masa süsleme',
        is_active: true,
        parent_id: 'CAT_005',
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString()
      },
      {
        id: 'SUBCAT_008',
        name: 'OPERASYON MÜDÜRÜ',
        description: 'Operasyon müdürü hizmeti',
        is_active: true,
        parent_id: 'CAT_006',
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString()
      },
      {
        id: 'SUBCAT_009',
        name: 'KARŞILAMA DESKİ',
        description: 'Karşılama desk hizmeti',
        is_active: true,
        parent_id: 'CAT_007',
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString()
      }
    ];
    
    localStorage.setItem('categories', JSON.stringify(defaultCategories));
    return defaultCategories;
  },

  async create(category: Omit<Category, 'id' | 'created_at' | 'updated_at'>): Promise<Category> {
    const newCategory: Category = {
      id: Date.now().toString(),
      ...category,
      created_at: new Date().toISOString(),
      updated_at: new Date().toISOString()
    };
    
    const categories = await this.getAll();
    const updatedCategories = [...categories, newCategory];
    localStorage.setItem('categories', JSON.stringify(updatedCategories));
    
    return newCategory;
  },

  async update(id: string, category: Partial<Category>): Promise<Category> {
    const categories = await this.getAll();
    const updatedCategories = categories.map(cat => 
      cat.id === id 
        ? { ...cat, ...category, updated_at: new Date().toISOString() }
        : cat
    );
    
    localStorage.setItem('categories', JSON.stringify(updatedCategories));
    return updatedCategories.find(cat => cat.id === id)!;
  },

  async delete(id: string): Promise<void> {
    const categories = await this.getAll();
    const updatedCategories = categories.filter(cat => cat.id !== id);
    localStorage.setItem('categories', JSON.stringify(updatedCategories));
  }
};

